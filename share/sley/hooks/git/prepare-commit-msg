#!/usr/bin/env bash
# prepare-commit-msg — gate Git sequencer commits that bypass pre-commit.

set -u

_sequencer_state_active() {
  local git_dir
  git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) || return 1
  [ -e "$git_dir/CHERRY_PICK_HEAD" ] ||
    [ -e "$git_dir/REVERT_HEAD" ] ||
    [ -d "$git_dir/rebase-merge" ] ||
    [ -d "$git_dir/rebase-apply" ]
}

_generated_revert_message() {
  local msg_file="$1" first_line="" _="" third_line=""
  [ -f "$msg_file" ] || return 1
  {
    IFS= read -r first_line || [[ -n "$first_line" ]] || return 1
    IFS= read -r _ || return 1
    IFS= read -r third_line || [[ -n "$third_line" ]] || return 1
  } <"$msg_file"
  case "$first_line" in
    "Revert \""*)
      case "$third_line" in
        "This reverts commit "*) return 0 ;;
      esac
      ;;
  esac
  return 1
}

# `git cherry-pick`, `git revert`, and conflict-resolved `git rebase
# --continue` create commits through the sequencer without invoking
# `pre-commit`. Run the same readiness gate here only when those states are
# active; ordinary `git commit` and automatic merges are already covered by
# `pre-commit` / `pre-merge-commit`.
if _sequencer_state_active || _generated_revert_message "${1:-}"; then
  _hook_dir=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 0
  _gate=${SLEY_GIT_COMMIT_GATE:-"$_hook_dir/sley-commit-gate"}
  exec "$_gate"
fi

exit 0
