printf '0\n' >"$SLEY_PERF_HASH_OBJECT_COUNT_FILE"
git -C "$repo" diff --name-only >"$autoformat_state/files"
for ((chunk = 1; chunk <= fix_chunks; chunk++)); do
  chunk_start=$(((chunk - 1) * FIX_FORMAT_CHUNK_FILES + 1))
  chunk_end=$((chunk * FIX_FORMAT_CHUNK_FILES))
  {
    printf '%s\n' --
    sed -n "${chunk_start},${chunk_end}p" "$autoformat_state/files"
  } >"$autoformat_state/expected-args.$chunk"
done

PATH="$probe_bin:$PATH" _run_perf_sley_timed 30 "$repo" fix
_assert_exit "fix perf: large changed tree exits 0" 0 "$__SLEY_RC"
_assert_autoformat_chunked_invocations \
  "fix perf: bounded batch formatter" 1 "$fix_chunks" \
  "$autoformat_state/expected-args"
_assert_file_content "fix perf: hashes bounded chunks before and after formatting" \
  "$((fix_chunks * 2))" "$SLEY_PERF_HASH_OBJECT_COUNT_FILE"
unset SLEY_PERF_HASH_OBJECT_COUNT_FILE

echo "=== sley: ready --fix --commit performance ==="

for changed_count in 1 10 50 300; do
  repo=$(_new_perf_repo)
  _write_staged_changed_tree "$repo" "$changed_count"
  autoformat_state=$(_tmpdir)
  ready_fix_chunks=$(((changed_count + READY_FIX_FORMAT_CHUNK_FILES - 1) / \
    READY_FIX_FORMAT_CHUNK_FILES))
  export SLEY_PERF_AUTOFORMAT_COUNT_FILE="$autoformat_state/count"
  export SLEY_PERF_AUTOFORMAT_ARGS_PREFIX="$autoformat_state/args"
  export SLEY_PERF_AUTOFORMAT_RC=0
  printf '0\n' >"$SLEY_PERF_AUTOFORMAT_COUNT_FILE"
  git -C "$repo" diff --cached --name-only -- staged >"$autoformat_state/files"
  for ((chunk = 1; chunk <= ready_fix_chunks; chunk++)); do
    chunk_start=$(((chunk - 1) * READY_FIX_FORMAT_CHUNK_FILES + 1))
    chunk_end=$((chunk * READY_FIX_FORMAT_CHUNK_FILES))
    {
      printf '%s\n' --
      sed -n "${chunk_start},${chunk_end}p" "$autoformat_state/files"
    } >"$autoformat_state/expected-args.$chunk"
  done

  _measure_perf_stats "ready --fix perf: ${changed_count}-file staged commit" 30 "$repo" \
    "$SLEY_READY_FIX_PERF_RUNS" ready --fix --commit --quiet \
    --exclude status --exclude check --exclude secrets --exclude verify
  echo "  PERF: ready --fix median ${__PERF_MEDIAN}ms (files ${changed_count}, runs ${SLEY_READY_FIX_PERF_RUNS})"
  _assert_autoformat_chunked_invocations \
    "ready --fix perf: ${changed_count}-file batch formatter" \
    "$SLEY_READY_FIX_PERF_RUNS" "$ready_fix_chunks" \
    "$autoformat_state/expected-args"

  if [[ "$changed_count" -eq 300 ]]; then
    ready_fix_median_budget=$(_perf_budget_ms \
      "$READY_FIX_300_MEDIAN_BUDGET_MS" \
      "$READY_FIX_300_DARWIN_MEDIAN_BUDGET_MS")
    _assert_ms_le "ready --fix perf: 300-file median" \
      "$__PERF_MEDIAN" "$ready_fix_median_budget"
  fi
done

echo "=== sley: ready --fix mixed partial performance ==="

repo=$(_new_perf_repo)
_write_staged_changed_tree "$repo" "$SLEY_PERF_CHANGED_FILES"
# Keep one staged file partially edited in the worktree. A no-op formatter may
# probe it safely, but membership checks must not fork once per selected file.
printf 'unstaged work\n' >>"$repo/staged/file-1.txt"

autoformat_state=$(_tmpdir)
export SLEY_PERF_AUTOFORMAT_COUNT_FILE="$autoformat_state/count"
export SLEY_PERF_AUTOFORMAT_ARGS_PREFIX="$autoformat_state/args"
export SLEY_PERF_AUTOFORMAT_RC=0
printf '0\n' >"$SLEY_PERF_AUTOFORMAT_COUNT_FILE"

grep_mock_bin=$(_mock_bin)
real_grep=$(command -v grep)
export SLEY_PERF_GREP_COUNT_FILE="$autoformat_state/grep-count"
export SLEY_PERF_REAL_GREP="$real_grep"
export SLEY_PERF_STAGED_NAME_COUNT_FILE="$autoformat_state/staged-name-count"
: >"$SLEY_PERF_GREP_COUNT_FILE"
printf '0\n' >"$SLEY_PERF_STAGED_NAME_COUNT_FILE"
cat >"$grep_mock_bin/grep" <<'EOF'
#!/usr/bin/env bash
printf '1\n' >>"$SLEY_PERF_GREP_COUNT_FILE"
exec "$SLEY_PERF_REAL_GREP" "$@"
EOF
chmod +x "$grep_mock_bin/grep"

saved_path=$PATH
PATH="$grep_mock_bin:$probe_bin:$PATH"
_run_perf_sley_timed 30 "$repo" ready --fix --commit --quiet \
  --exclude status --exclude check --exclude secrets --exclude verify
PATH=$saved_path
_assert_exit "ready --fix mixed perf: instrumented run exits 0" 0 "$__SLEY_RC"
grep_count=$(wc -l <"$SLEY_PERF_GREP_COUNT_FILE" | tr -d '[:space:]')
_assert_eq "ready --fix mixed perf: no membership grep processes" 0 "$grep_count"
_assert_file_content "ready --fix mixed perf: enumerates staged names once" \
  "1" "$SLEY_PERF_STAGED_NAME_COUNT_FILE"
unset SLEY_PERF_STAGED_NAME_COUNT_FILE

printf '0\n' >"$SLEY_PERF_AUTOFORMAT_COUNT_FILE"
mixed_ready_fix_chunks=$(((SLEY_PERF_CHANGED_FILES - 1 + \
  READY_FIX_FORMAT_CHUNK_FILES - 1) / READY_FIX_FORMAT_CHUNK_FILES))
mixed_ready_fix_invocations=$((1 + mixed_ready_fix_chunks))
_measure_perf_stats "ready --fix mixed perf: ${SLEY_PERF_CHANGED_FILES} staged plus one partial" 30 "$repo" \
  "$SLEY_READY_FIX_PERF_RUNS" ready --fix --commit --quiet \
  --exclude status --exclude check --exclude secrets --exclude verify
echo "  PERF: ready --fix mixed median ${__PERF_MEDIAN}ms (files ${SLEY_PERF_CHANGED_FILES}, partial 1, runs ${SLEY_READY_FIX_PERF_RUNS})"
_assert_eq "ready --fix mixed perf: formatter invocation count" \
  "$((SLEY_READY_FIX_PERF_RUNS * mixed_ready_fix_invocations))" \
  "$(cat "$SLEY_PERF_AUTOFORMAT_COUNT_FILE")"
_assert_contains "ready --fix mixed perf: partial worktree edit survives" \
  "unstaged work" "$(cat "$repo/staged/file-1.txt")"

echo "=== sley perf: VCS discovery skips impossible probes ==="

# The upward metadata scan must remove subprocesses, not just time: count
# probe invocations with logging mocks. No wall-clock assertions here — these
# hold under any load.
_perf_detect_git_spawns_sl() {
  local git_repo="$1" mockbin="$2" count_file="$3" out rc
  export SLEY_PERF_SL_COUNT_FILE="$count_file"
  printf '0\n' >"$count_file"
  cat >"$mockbin/sl" <<'MOCK'
#!/usr/bin/env bash
count=$(cat "$SLEY_PERF_SL_COUNT_FILE")
printf '%s\n' "$((count + 1))" >"$SLEY_PERF_SL_COUNT_FILE"
exit 1
MOCK
  chmod +x "$mockbin/sl"
  out=""
  rc=0
  out=$(cd "$git_repo" && PATH="$mockbin:$PATH" \
    XDG_CONFIG_HOME="$git_repo/.xdg-config" XDG_CACHE_HOME="$git_repo/.xdg-cache" \
    GIT_CONFIG_GLOBAL="$git_repo/.gitconfig-test" "$SLEY" status 2>&1) || rc=$?
  printf '%s\n%s' "$rc" "$out"
}

detect_perf_repo=$(_new_perf_repo)
(cd "$detect_perf_repo" && echo one >file.txt && git add file.txt && git commit -qm "seed detect perf")
detect_perf_mock=$(_mock_bin)
detect_perf_sl_count=$(_tmpdir)/sl-count.txt
detect_perf_status=$(_perf_detect_git_spawns_sl "$detect_perf_repo" "$detect_perf_mock" "$detect_perf_sl_count")
detect_perf_rc=$(printf '%s\n' "$detect_perf_status" | head -1)
_assert_exit "detect perf: status in git-only repo exits 0" 0 "$detect_perf_rc"
_assert_eq "detect perf: status in git-only repo never probes sl" \
  "0" "$(cat "$detect_perf_sl_count")"
unset SLEY_PERF_SL_COUNT_FILE

detect_perf_empty=$(_tmpdir)
detect_perf_nomock=$(_mock_bin)
detect_perf_probes=$(_tmpdir)/norepo-probes.log
: >"$detect_perf_probes"
export SLEY_PERF_PROBE_LOG="$detect_perf_probes"
cat >"$detect_perf_nomock/git" <<'MOCK'
#!/usr/bin/env bash
printf 'git %s\n' "$*" >>"$SLEY_PERF_PROBE_LOG"
exit 1
MOCK
cat >"$detect_perf_nomock/sl" <<'MOCK'
#!/usr/bin/env bash
printf 'sl %s\n' "$*" >>"$SLEY_PERF_PROBE_LOG"
exit 1
MOCK
chmod +x "$detect_perf_nomock/git" "$detect_perf_nomock/sl"
detect_perf_norepo_out=""
detect_perf_norepo_rc=0
detect_perf_norepo_out=$(cd "$detect_perf_empty" && PATH="$detect_perf_nomock:$PATH" \
  XDG_CONFIG_HOME="$detect_perf_empty/.xdg-config" XDG_CACHE_HOME="$detect_perf_empty/.xdg-cache" \
  "$SLEY" status 2>&1) || detect_perf_norepo_rc=$?
_assert_exit "detect perf: status outside repos exits 2" 2 "$detect_perf_norepo_rc"
_assert_contains "detect perf: status outside repos reports unsupported repo" \
  "unsupported repo" "$detect_perf_norepo_out"
_assert_eq "detect perf: status outside repos spawns no VCS probes" \
  "" "$(cat "$detect_perf_probes")"
unset SLEY_PERF_PROBE_LOG

# sl-only detection (direct probe: the CLI path needs full `sl status`
# surface mocks, while the skip decision lives in `_repo_detect`).
detect_perf_slroot=$(_tmpdir)
mkdir -p "$detect_perf_slroot/.sl"
detect_perf_slroot_phys=$(cd "$detect_perf_slroot" && pwd -P)
detect_perf_slmock=$(_mock_bin)
detect_perf_gitlog=$(_tmpdir)/slonly-git.log
: >"$detect_perf_gitlog"
export SLEY_PERF_GIT_LOG="$detect_perf_gitlog" SLEY_PERF_MOCKBIN="$detect_perf_slmock"
export MOCK_SL_ROOT="$detect_perf_slroot_phys"
cat >"$detect_perf_slmock/git" <<'MOCK'
#!/usr/bin/env bash
printf 'git %s\n' "$*" >>"$SLEY_PERF_GIT_LOG"
# Strip this mock's own directory before delegating: PATH-resolving `git`
# launchers re-scan PATH at their runtime and would otherwise re-pick this
# mock as the "real" git and recurse.
PATH=":$PATH:"
PATH="${PATH//:$SLEY_PERF_MOCKBIN:/:}"
PATH="${PATH#:}"
PATH="${PATH%:}"
export PATH
exec git "$@"
MOCK
cat >"$detect_perf_slmock/sl" <<'MOCK'
#!/usr/bin/env bash
[[ "${1:-}" == "root" ]] || exit 1
printf '%s\n' "$MOCK_SL_ROOT"
MOCK
chmod +x "$detect_perf_slmock/git" "$detect_perf_slmock/sl"
detect_perf_slonly_hit=$(cd "$detect_perf_slroot" && PATH="$detect_perf_slmock:$PATH" \
  SLEY_REPO_ROOT="$SLEY_REPO_ROOT" \
  bash -c 'source "$SLEY_REPO_ROOT/lib/sley/repo.sh"; _repo_detect; printf "%s|%s" "$_REPO_TYPE" "$_REPO_ROOT"')
_assert_eq "detect perf: sl-only probe still resolves sl" \
  "sl|$detect_perf_slroot_phys" "$detect_perf_slonly_hit"
if grep -q "show-toplevel" "$detect_perf_gitlog"; then
  _fail "detect perf: sl-only probe never runs git rev-parse (saw: $(cat "$detect_perf_gitlog"))"
else
  _pass "detect perf: sl-only probe never runs git rev-parse"
fi
unset SLEY_PERF_GIT_LOG SLEY_PERF_MOCKBIN MOCK_SL_ROOT

echo "=== sley perf: hook path avoids verify/ready parse and launcher probe ==="

# Sourcing the library must not define verify/ready entry points; the
# wrappers load them on first use (proven functionally by the lazy behavior
# block). No wall-clock assertions — definition presence is the signal.
lazy_perf_defined=$(
  SLEY_REPO_ROOT="$SLEY_REPO_ROOT" bash -c '
    source "$SLEY_REPO_ROOT/lib/sley/sley.sh" || exit 3
    echo "verify=$(declare -F _sley_verify)"
    echo "ready=$(declare -F _sley_ready)"
    echo "hook=$(declare -F _sley_hook_format_file)"
  '
)
_assert_contains "lazy perf: sourcing leaves _sley_verify undefined" \
  "verify=" "$lazy_perf_defined"
_assert_not_contains "lazy perf: sourcing defines no _sley_verify body" \
  "_sley_verify" "$lazy_perf_defined"
_assert_contains "lazy perf: sourcing leaves _sley_ready undefined" \
  "ready=" "$lazy_perf_defined"
_assert_not_contains "lazy perf: sourcing defines no _sley_ready body" \
  "_sley_ready" "$lazy_perf_defined"
_assert_contains "lazy perf: sourcing still defines hook entry points" \
  "_sley_hook_format_file" "$lazy_perf_defined"

# With a caller `_REPO_TYPE` override the launcher hint is never consumed,
# so the legacy path probes twice (launcher + hook-init). The skip must cut
# that to one probe; with bare env configured the legacy double probe stays.
_perf_hook_probe_counts() {
  local repo="$1" file="$2" outside="$3" mockbin="$4" gitlog="$5" slcount="$6"
  shift 6
  export SLEY_PERF_HOOK_GIT_LOG="$gitlog" SLEY_PERF_HOOK_MOCKBIN="$mockbin"
  export SLEY_PERF_HOOK_SL_COUNT="$slcount"
  printf '0\n' >"$slcount"
  : >"$gitlog"
  cat >"$mockbin/git" <<'MOCK'
#!/usr/bin/env bash
printf 'git %s\n' "$*" >>"$SLEY_PERF_HOOK_GIT_LOG"
PATH=":$PATH:"
PATH="${PATH//:$SLEY_PERF_HOOK_MOCKBIN:/:}"
PATH="${PATH#:}"
PATH="${PATH%:}"
export PATH
exec git "$@"
MOCK
  cat >"$mockbin/sl" <<'MOCK'
#!/usr/bin/env bash
count=$(cat "$SLEY_PERF_HOOK_SL_COUNT")
printf '%s\n' "$((count + 1))" >"$SLEY_PERF_HOOK_SL_COUNT"
exit 1
MOCK
  cat >"$mockbin/autoformat" <<'MOCK'
#!/usr/bin/env bash
exit 0
MOCK
  chmod +x "$mockbin/git" "$mockbin/sl" "$mockbin/autoformat"
  (cd "$outside" && PATH="$mockbin:$PATH" "$@" \
    XDG_CONFIG_HOME="$repo/.xdg-config" XDG_CACHE_HOME="$repo/.xdg-cache" \
    GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" \
    "$SLEY" hook format-file "$file" >/dev/null 2>&1) || true
}

hook_perf_repo=$(_new_perf_repo)
printf 'x = 1\n' >"$hook_perf_repo/hook.py"
(cd "$hook_perf_repo" && git add hook.py && git commit -qm "seed hook probe perf")
hook_perf_outside=$(_tmpdir)
hook_perf_mock=$(_mock_bin)
hook_perf_gitlog=$(_tmpdir)/hook-git.log
hook_perf_slcount=$(_tmpdir)/hook-sl-count.txt
# Isolate from ambient bare-repo env (dotfiles hosts export it): the skip
# applies only when no bare fallback could engage.
_perf_hook_probe_counts "$hook_perf_repo" "$hook_perf_repo/hook.py" \
  "$hook_perf_outside" "$hook_perf_mock" "$hook_perf_gitlog" "$hook_perf_slcount" \
  env -u SLEY_BARE_REPO_GIT_DIR -u SLEY_BARE_REPO_WORK_TREE _REPO_TYPE=git
hook_perf_git_probes=$(grep -c "rev-parse --show-toplevel" "$hook_perf_gitlog" || true)
_assert_eq "hook perf: override probes git exactly once (launcher skip)" \
  "1" "$hook_perf_git_probes"
_assert_eq "hook perf: override never probes sl" \
  "0" "$(cat "$hook_perf_slcount")"

hook_perf_bare=$(_tmpdir)
git init -q --bare "$hook_perf_bare/bare.git"
_perf_hook_probe_counts "$hook_perf_repo" "$hook_perf_repo/hook.py" \
  "$hook_perf_outside" "$hook_perf_mock" "$hook_perf_gitlog" "$hook_perf_slcount" \
  env _REPO_TYPE=git SLEY_BARE_REPO_GIT_DIR="$hook_perf_bare/bare.git" \
  SLEY_BARE_REPO_WORK_TREE="$hook_perf_bare"
hook_perf_bare_probes=$(grep -c "rev-parse --show-toplevel" "$hook_perf_gitlog" || true)
_assert_eq "hook perf: bare env keeps legacy launcher probe (two total)" \
  "2" "$hook_perf_bare_probes"
_assert_eq "hook perf: bare env never probes sl" \
  "0" "$(cat "$hook_perf_slcount")"
unset SLEY_PERF_HOOK_GIT_LOG SLEY_PERF_HOOK_MOCKBIN SLEY_PERF_HOOK_SL_COUNT

_test_summary
