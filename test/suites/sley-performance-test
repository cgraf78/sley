  "$VERIFY_DISCOVERY_DARWIN_MAX_BUDGET_MS")
discovery_report_runs="$SLEY_PERF_RUNS"

# Hosted macOS runners can occasionally sustain contention across an entire
# seven-sample batch. Confirm only that narrow case: a command failure or a
# coarse-maximum breach remains immediately fatal, while a median-only breach
# gets two fresh batches on the same already-warm fixture. The median of three
# batch medians lets one transient slow batch be outvoted while two slow batches
# remain a failure. The maximum still covers all 21 observed samples.
if _should_confirm_perf \
  "$(uname -s)" \
  "$discovery_median" \
  "$discovery_max" \
  "$discovery_median_budget" \
  "$discovery_max_budget"; then
  discovery_initial_median="$discovery_median"
  discovery_initial_max="$discovery_max"
  discovery_initial_durations="$repo/.sley-perf-durations.initial"
  cp "$repo/.sley-perf-durations" "$discovery_initial_durations"
  discovery_confirmation_files=()

  echo "  PERF: verify discovery median-only breach; collecting two confirmation batches"
  for discovery_confirmation_batch in 1 2; do
    _measure_perf_stats "verify perf: large shared subtree confirmation" 15 \
      "$repo" "$SLEY_PERF_RUNS" verify --json
    discovery_confirmation_file="$repo/.sley-perf-durations.confirmation-$discovery_confirmation_batch"
    cp "$repo/.sley-perf-durations" "$discovery_confirmation_file"
    discovery_confirmation_files+=("$discovery_confirmation_file")
    echo "  PERF: verify discovery confirmation ${discovery_confirmation_batch} median ${__PERF_MEDIAN}ms, maximum ${__PERF_MAX}ms"
  done

  _combine_perf_batches \
    "$SLEY_PERF_RUNS" \
    "$repo/.sley-perf-durations.combined" \
    "$discovery_initial_durations" \
    "${discovery_confirmation_files[@]}"
  discovery_report_runs="$__PERF_RUNS"
  discovery_median="$__PERF_MEDIAN"
  discovery_max="$__PERF_MAX"
  echo "  PERF: verify discovery initial median ${discovery_initial_median}ms, maximum ${discovery_initial_max}ms; three-batch median ${discovery_median}ms, maximum across ${discovery_report_runs} samples ${discovery_max}ms"
fi

