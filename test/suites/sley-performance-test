#!/usr/bin/env bash
# sley-performance-test - guard the shape of latency-sensitive workflow paths.

set -euo pipefail

SLEY_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
SLEY_REPO_ROOT="$(cd -- "$SLEY_TEST_DIR/.." && pwd -P)"
SLEY="$SLEY_REPO_ROOT/bin/sley"

# shellcheck source=../helpers.sh
. "$SLEY_TEST_DIR/helpers.sh"

SLEY_PERF_RUNS=${SLEY_PERF_RUNS:-7}
SLEY_HOOK_PERF_RUNS=${SLEY_HOOK_PERF_RUNS:-20}
SLEY_READY_FIX_PERF_RUNS=${SLEY_READY_FIX_PERF_RUNS:-3}
SLEY_PERF_CHANGED_FILES=${SLEY_PERF_CHANGED_FILES:-300}
SLEY_PERF_BUDGET_MULTIPLIER_ENV=SLEY_PERF_BUDGET_MULTIPLIER

# These measure user-visible CLI paths, including repo detection, changed-file
# discovery, JSON command grouping, hook dispatch, and process startup. They are
# intentionally not microbenchmarks; hooks and agent workflows pay the full cost.
VERIFY_DISCOVERY_MEDIAN_BUDGET_MS=2500
VERIFY_DISCOVERY_DARWIN_MEDIAN_BUDGET_MS=3500
VERIFY_DISCOVERY_MAX_BUDGET_MS=9000
VERIFY_DISCOVERY_DARWIN_MAX_BUDGET_MS=12000
VERIFY_REQUIRED_REGISTRY_MEDIAN_BUDGET_MS=2500
VERIFY_REQUIRED_REGISTRY_DARWIN_MEDIAN_BUDGET_MS=3500
VERIFY_REQUIRED_REGISTRY_MAX_BUDGET_MS=9000
VERIFY_REQUIRED_REGISTRY_DARWIN_MAX_BUDGET_MS=12000
HOOK_FORMAT_FILE_MEDIAN_BUDGET_MS=350
HOOK_FORMAT_FILE_DARWIN_MEDIAN_BUDGET_MS=500
HOOK_FORMAT_FILE_P95_BUDGET_MS=1000
HOOK_FORMAT_FILE_DARWIN_P95_BUDGET_MS=1500
READY_FIX_300_MEDIAN_BUDGET_MS=5000
READY_FIX_300_DARWIN_MEDIAN_BUDGET_MS=7000
READY_FIX_FORMAT_CHUNK_FILES=256

perf_mock_bin=$(_mock_bin)
cat >"$perf_mock_bin/checkrun" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

: "${SLEY_PERF_CHECKRUN_COUNT_FILE:?}"
: "${SLEY_PERF_CHECKRUN_ARGS_PREFIX:?}"
: "${SLEY_PERF_CHECKRUN_HOME_PREFIX:?}"

count=$(cat "$SLEY_PERF_CHECKRUN_COUNT_FILE")
count=$((count + 1))
printf '%s\n' "$count" >"$SLEY_PERF_CHECKRUN_COUNT_FILE"
printf '%s\n' "$@" >"${SLEY_PERF_CHECKRUN_ARGS_PREFIX}.${count}"
printf '%s\n' "$HOME" >"${SLEY_PERF_CHECKRUN_HOME_PREFIX}.${count}"
EOF
cat >"$perf_mock_bin/autoformat" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

: "${SLEY_PERF_AUTOFORMAT_COUNT_FILE:?}"
: "${SLEY_PERF_AUTOFORMAT_ARGS_PREFIX:?}"

count=$(cat "$SLEY_PERF_AUTOFORMAT_COUNT_FILE")
count=$((count + 1))
printf '%s\n' "$count" >"$SLEY_PERF_AUTOFORMAT_COUNT_FILE"
printf '%s\n' "$@" >"${SLEY_PERF_AUTOFORMAT_ARGS_PREFIX}.${count}"
exit "${SLEY_PERF_AUTOFORMAT_RC:-0}"
EOF
chmod +x "$perf_mock_bin/checkrun" "$perf_mock_bin/autoformat"
export PATH="$perf_mock_bin:$PATH"

_new_perf_repo() {
  local repo
  repo=$(_tmpdir)
  (
    cd "$repo" || exit 1
    export GIT_CONFIG_GLOBAL="$repo/.gitconfig-test"
    : >"$GIT_CONFIG_GLOBAL"
    git init -q
    git config user.email test@test.local
    git config user.name "Test User"
    mkdir -p "$repo/.hooks"
    git config core.hooksPath "$repo/.hooks"
    git config commit.gpgsign false
  )
  (cd "$repo" && pwd -P)
}

_perf_budget_ms() {
  local base_ms="$1" darwin_ms="${2:-}" multiplier
  if [[ "$(uname -s)" == "Darwin" && -n "$darwin_ms" ]]; then
    base_ms="$darwin_ms"
  fi
  multiplier="${!SLEY_PERF_BUDGET_MULTIPLIER_ENV:-1}"
  if ! [[ "$multiplier" =~ ^[1-9][0-9]*$ ]]; then
    multiplier=1
  fi
  printf '%s\n' "$((base_ms * multiplier))"
}

_assert_ms_le() {
  local desc="$1" actual_ms="$2" budget_ms="$3"
  if [[ "$actual_ms" -le "$budget_ms" ]]; then
    _pass "$desc (${actual_ms}ms <= ${budget_ms}ms)"
  else
    _fail "$desc (${actual_ms}ms > ${budget_ms}ms)"
  fi
}

_assert_file_matches() {
  local desc="$1" expected="$2" actual="$3" expected_content actual_content
  if [[ ! -f "$expected" || ! -f "$actual" ]]; then
    _fail "$desc (file missing: $expected $actual)"
    return
  fi
  expected_content=$(<"$expected")
  actual_content=$(<"$actual")
  if [[ "$expected_content" == "$actual_content" ]]; then
    _pass "$desc"
  else
    _fail "$desc (files differ: $expected $actual)"
  fi
}

_assert_checkrun_invocations() {
  local desc="$1" expected_count="$2" expected_args="$3" expected_home="$4" count run
  count=$(cat "$SLEY_PERF_CHECKRUN_COUNT_FILE")
  _assert_eq "$desc count" "$expected_count" "$count"
  for ((run = 1; run <= count; run++)); do
    _assert_file_matches "$desc args $run" \
      "$expected_args" "${SLEY_PERF_CHECKRUN_ARGS_PREFIX}.${run}"
    _assert_file_content "$desc home $run" \
      "$expected_home" "${SLEY_PERF_CHECKRUN_HOME_PREFIX}.${run}"
  done
}

_assert_autoformat_invocations() {
  local desc="$1" expected_count="$2" expected_args="$3" count run
  count=$(cat "$SLEY_PERF_AUTOFORMAT_COUNT_FILE")
  _assert_eq "$desc count" "$expected_count" "$count"
  for ((run = 1; run <= count; run++)); do
    _assert_file_matches "$desc args $run" \
      "$expected_args" "${SLEY_PERF_AUTOFORMAT_ARGS_PREFIX}.${run}"
  done
}

_assert_autoformat_chunked_invocations() {
  local desc="$1" expected_runs="$2" chunks_per_run="$3" expected_prefix="$4"
  local count run chunk invocation expected_count
  count=$(cat "$SLEY_PERF_AUTOFORMAT_COUNT_FILE")
  expected_count=$((expected_runs * chunks_per_run))
  _assert_eq "$desc count" "$expected_count" "$count"
  for ((run = 1; run <= expected_runs; run++)); do
    for ((chunk = 1; chunk <= chunks_per_run; chunk++)); do
      invocation=$(((run - 1) * chunks_per_run + chunk))
      _assert_file_matches "$desc run $run chunk $chunk" \
        "$expected_prefix.$chunk" \
        "${SLEY_PERF_AUTOFORMAT_ARGS_PREFIX}.${invocation}"
    done
  done
}

_p95_ms() {
  local runs="$1" index
  index=$(((runs * 95 + 99) / 100))
  sed -n "${index}p"
}

_median_ms() {
  local runs="$1"
  awk -v runs="$runs" '
    NR == int((runs + 1) / 2) { lower = $1 }
    NR == int((runs + 2) / 2) { upper = $1 }
    END { print int((lower + upper) / 2) }
  '
}

_run_perf_sley_timed() {
  local timeout_secs="$1" repo="$2"
  shift 2
  local home xdg_config_home xdg_cache_home output_file rc_file
  home="$repo/.home"
  xdg_config_home="$repo/.xdg-config"
  xdg_cache_home="$repo/.xdg-cache"
  output_file="$repo/.sley-perf-output"
  rc_file="$repo/.sley-perf-rc"
  mkdir -p "$home" "$xdg_config_home" "$xdg_cache_home"
  __SLEY_MS=$(
    cd "$repo" &&
      HOME="$home" \
        XDG_CONFIG_HOME="$xdg_config_home" \
        XDG_CACHE_HOME="$xdg_cache_home" \
        GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" \
        python3 - "$timeout_secs" "$output_file" "$rc_file" "$SLEY" "$@" <<'PY'
import os
import subprocess
import sys
import time

timeout = float(sys.argv[1])
output_file = sys.argv[2]
rc_file = sys.argv[3]
cmd = sys.argv[4:]

started = time.perf_counter_ns()
try:
    completed = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        timeout=timeout,
        env=os.environ.copy(),
    )
    rc = completed.returncode
    output = completed.stdout
except subprocess.TimeoutExpired as exc:
    rc = 124
    output = exc.stdout or ""
    if isinstance(output, bytes):
        output = output.decode(errors="replace")

elapsed_ms = max(1, (time.perf_counter_ns() - started) // 1_000_000)
with open(output_file, "w", encoding="utf-8") as handle:
    handle.write(output)
with open(rc_file, "w", encoding="utf-8") as handle:
    handle.write(str(rc))
print(elapsed_ms)
PY
  )
  __SLEY_OUT=$(cat "$output_file")
  __SLEY_RC=$(cat "$rc_file")
}

_measure_perf_stats() {
  local desc="$1" timeout_secs="$2" repo="$3" runs="$4"
  shift 4
  local durations_file sorted_file run
  durations_file="$repo/.sley-perf-durations"
  sorted_file="$durations_file.sorted"
  : >"$durations_file"
  for run in $(seq 1 "$runs"); do
    _run_perf_sley_timed "$timeout_secs" "$repo" "$@"
    if [[ "$__SLEY_RC" -ne 0 ]]; then
      _fail "$desc sample $run exits 0 (got $__SLEY_RC; output: $__SLEY_OUT)"
      return 1
    fi
    printf '%s\n' "$__SLEY_MS" >>"$durations_file"
  done
  LC_ALL=C sort -n "$durations_file" >"$sorted_file"
  __PERF_MEDIAN=$(_median_ms "$runs" <"$sorted_file")
  __PERF_P95=$(_p95_ms "$runs" <"$sorted_file")
  __PERF_MAX=$(tail -n 1 "$sorted_file")
}

_write_changed_tree() {
  local repo="$1" count="$2" i dir file
  dir="$repo/packages/app/src/generated/deep/nested"
  mkdir -p "$dir"
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i.js"
    printf 'export const value%s = %s;\n' "$i" "$i" >"$file"
  done
  (
    cd "$repo" || exit 1
    git add .
    git commit -q -m "seed large verify fixture"
  )
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i.js"
    printf 'export const changed%s = %s;\n' "$i" "$i" >>"$file"
  done
}

_write_staged_changed_tree() {
  local repo="$1" count="$2" i dir file
  dir="$repo/staged"
  mkdir -p "$dir"
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i.txt"
    printf 'base %s\n' "$i" >"$file"
  done
  (
    cd "$repo" || exit 1
    git add staged
    git commit -q -m "seed staged ready fixture"
  )
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i.txt"
    printf 'changed %s\n' "$i" >>"$file"
  done
  (cd "$repo" && git add staged)
}

echo "=== sley: verify performance ==="

repo=$(_new_perf_repo)
mkdir -p "$repo/packages/app"
cat >"$repo/package.json" <<'EOF'
{"scripts":{"test":"node root-test.js","lint":"node root-lint.js"}}
EOF
cat >"$repo/packages/app/package.json" <<'EOF'
{"scripts":{"test":"node app-test.js","lint":"node app-lint.js","build":"node app-build.js"}}
EOF
_write_changed_tree "$repo" "$SLEY_PERF_CHANGED_FILES"

_run_perf_sley_timed 15 "$repo" verify --json
_assert_exit "verify perf: large shared subtree discovery exits 0" 0 "$__SLEY_RC"
_assert_contains "verify perf: discovers ancestor manifest command" "node app-test.js" "$__SLEY_OUT"
_assert_contains "verify perf: discovers repo-root manifest command" "node root-test.js" "$__SLEY_OUT"
_measure_perf_stats "verify perf: large shared subtree discovery" 15 "$repo" \
  "$SLEY_PERF_RUNS" verify --json
discovery_median="$__PERF_MEDIAN"
discovery_max="$__PERF_MAX"
discovery_median_budget=$(_perf_budget_ms \
  "$VERIFY_DISCOVERY_MEDIAN_BUDGET_MS" \
  "$VERIFY_DISCOVERY_DARWIN_MEDIAN_BUDGET_MS")
discovery_max_budget=$(_perf_budget_ms \
  "$VERIFY_DISCOVERY_MAX_BUDGET_MS" \
  "$VERIFY_DISCOVERY_DARWIN_MAX_BUDGET_MS")
echo "  PERF: verify discovery median ${discovery_median}ms / ${discovery_median_budget}ms, maximum ${discovery_max}ms / ${discovery_max_budget}ms (files ${SLEY_PERF_CHANGED_FILES}, runs ${SLEY_PERF_RUNS})"
_assert_ms_le "verify perf: large shared subtree discovery median" \
  "$discovery_median" "$discovery_median_budget"
_assert_ms_le "verify perf: large shared subtree discovery maximum" \
  "$discovery_max" "$discovery_max_budget"

repo=$(_new_perf_repo)
mkdir -p "$repo/.sley" "$repo/tests"
checkrun_state=$(_tmpdir)
export SLEY_PERF_CHECKRUN_COUNT_FILE="$checkrun_state/count"
export SLEY_PERF_CHECKRUN_ARGS_PREFIX="$checkrun_state/args"
export SLEY_PERF_CHECKRUN_HOME_PREFIX="$checkrun_state/home"
printf '0\n' >"$SLEY_PERF_CHECKRUN_COUNT_FILE"
cat >"$repo/.sley/verify.json" <<'EOF'
{
  "rules": [
    {
      "paths": ["packages/app/src/**"],
      "commands": [
        {
          "cmd": "./tests/run-once.sh",
          "required": true
        }
      ]
    }
  ]
}
EOF
cat >"$repo/tests/run-once.sh" <<'EOF'
#!/usr/bin/env bash
count=0
[[ -f tests/count ]] && count=$(cat tests/count)
count=$((count + 1))
printf '%s\n' "$count" > tests/count
EOF
chmod +x "$repo/tests/run-once.sh"
_write_changed_tree "$repo" "$SLEY_PERF_CHANGED_FILES"
{
  printf '%s\n' verify --
  git -C "$repo" diff --name-only
} >"$checkrun_state/expected-args"

_run_perf_sley_timed 15 "$repo" verify --run-required --json
_assert_exit "verify perf: large registry run exits 0" 0 "$__SLEY_RC"
_assert_contains "verify perf: reports required command pass" '"status":"passed"' "$__SLEY_OUT"
_assert_file_content "verify perf: grouped required command runs once" "1" "$repo/tests/count"
_assert_checkrun_invocations "verify perf: fixture-owned Checkrun initial run" \
  1 "$checkrun_state/expected-args" "$repo/.home"
_measure_perf_stats "verify perf: large registry" 15 "$repo" \
  "$SLEY_PERF_RUNS" verify --run-required --json
registry_median="$__PERF_MEDIAN"
registry_max="$__PERF_MAX"
registry_median_budget=$(_perf_budget_ms \
  "$VERIFY_REQUIRED_REGISTRY_MEDIAN_BUDGET_MS" \
  "$VERIFY_REQUIRED_REGISTRY_DARWIN_MEDIAN_BUDGET_MS")
registry_max_budget=$(_perf_budget_ms \
  "$VERIFY_REQUIRED_REGISTRY_MAX_BUDGET_MS" \
  "$VERIFY_REQUIRED_REGISTRY_DARWIN_MAX_BUDGET_MS")
echo "  PERF: verify required registry median ${registry_median}ms / ${registry_median_budget}ms, maximum ${registry_max}ms / ${registry_max_budget}ms (files ${SLEY_PERF_CHANGED_FILES}, runs ${SLEY_PERF_RUNS})"
_assert_ms_le "verify perf: large registry median" \
  "$registry_median" "$registry_median_budget"
_assert_ms_le "verify perf: large registry maximum" \
  "$registry_max" "$registry_max_budget"
_assert_checkrun_invocations "verify perf: fixture-owned Checkrun measured runs" \
  "$((SLEY_PERF_RUNS + 1))" "$checkrun_state/expected-args" "$repo/.home"

echo "=== sley: hook performance ==="

repo=$(_new_perf_repo)
printf 'print("hook")\n' >"$repo/hook.py"
(cd "$repo" && git add hook.py && git commit -q -m "seed hook fixture")
autoformat_state=$(_tmpdir)
export SLEY_PERF_AUTOFORMAT_COUNT_FILE="$autoformat_state/count"
export SLEY_PERF_AUTOFORMAT_ARGS_PREFIX="$autoformat_state/args"
printf '0\n' >"$SLEY_PERF_AUTOFORMAT_COUNT_FILE"
{
  printf '%s\n' -- "$repo/hook.py"
} >"$autoformat_state/expected-args"

export SLEY_PERF_AUTOFORMAT_RC=7
_run_perf_sley_timed 5 "$repo" hook format-file "$repo/hook.py"
_assert_exit "hook format-file perf: propagates formatter exit" 7 "$__SLEY_RC"
_assert_autoformat_invocations "hook format-file perf: failing formatter delegation" \
  1 "$autoformat_state/expected-args"

export SLEY_PERF_AUTOFORMAT_RC=0
printf '0\n' >"$SLEY_PERF_AUTOFORMAT_COUNT_FILE"
_measure_perf_stats "hook format-file perf: full CLI" 5 "$repo" \
  "$SLEY_HOOK_PERF_RUNS" hook format-file "$repo/hook.py"
hook_format_file_p95="$__PERF_P95"
hook_format_file_median="$__PERF_MEDIAN"
hook_format_file_median_budget=$(_perf_budget_ms \
  "$HOOK_FORMAT_FILE_MEDIAN_BUDGET_MS" \
  "$HOOK_FORMAT_FILE_DARWIN_MEDIAN_BUDGET_MS")
hook_format_file_p95_budget=$(_perf_budget_ms \
  "$HOOK_FORMAT_FILE_P95_BUDGET_MS" \
  "$HOOK_FORMAT_FILE_DARWIN_P95_BUDGET_MS")
echo "  PERF: hook format-file median ${hook_format_file_median}ms / ${hook_format_file_median_budget}ms, p95 ${hook_format_file_p95}ms / ${hook_format_file_p95_budget}ms (runs ${SLEY_HOOK_PERF_RUNS})"
_assert_ms_le "hook format-file perf: full CLI median" \
  "$hook_format_file_median" "$hook_format_file_median_budget"
_assert_ms_le "hook format-file perf: full CLI p95" \
  "$hook_format_file_p95" "$hook_format_file_p95_budget"
_assert_autoformat_invocations "hook format-file perf: measured delegation" \
  "$SLEY_HOOK_PERF_RUNS" "$autoformat_state/expected-args"

echo "=== sley: ready --fix --commit performance ==="

for changed_count in 1 10 50 300; do
  repo=$(_new_perf_repo)
  _write_staged_changed_tree "$repo" "$changed_count"
  autoformat_state=$(_tmpdir)
  ready_fix_chunks=$(((changed_count + READY_FIX_FORMAT_CHUNK_FILES - 1) / \
    READY_FIX_FORMAT_CHUNK_FILES))
  export SLEY_PERF_AUTOFORMAT_COUNT_FILE="$autoformat_state/count"
  export SLEY_PERF_AUTOFORMAT_ARGS_PREFIX="$autoformat_state/args"
  export SLEY_PERF_AUTOFORMAT_RC=0
  printf '0\n' >"$SLEY_PERF_AUTOFORMAT_COUNT_FILE"
  git -C "$repo" diff --cached --name-only -- staged >"$autoformat_state/files"
  for ((chunk = 1; chunk <= ready_fix_chunks; chunk++)); do
    chunk_start=$(((chunk - 1) * READY_FIX_FORMAT_CHUNK_FILES + 1))
    chunk_end=$((chunk * READY_FIX_FORMAT_CHUNK_FILES))
    {
      printf '%s\n' --
      sed -n "${chunk_start},${chunk_end}p" "$autoformat_state/files"
    } >"$autoformat_state/expected-args.$chunk"
  done

  _measure_perf_stats "ready --fix perf: ${changed_count}-file staged commit" 30 "$repo" \
    "$SLEY_READY_FIX_PERF_RUNS" ready --fix --commit --quiet \
    --exclude status --exclude check --exclude secrets --exclude verify
  echo "  PERF: ready --fix median ${__PERF_MEDIAN}ms (files ${changed_count}, runs ${SLEY_READY_FIX_PERF_RUNS})"
  _assert_autoformat_chunked_invocations \
    "ready --fix perf: ${changed_count}-file batch formatter" \
    "$SLEY_READY_FIX_PERF_RUNS" "$ready_fix_chunks" \
    "$autoformat_state/expected-args"

  if [[ "$changed_count" -eq 300 ]]; then
    ready_fix_median_budget=$(_perf_budget_ms \
      "$READY_FIX_300_MEDIAN_BUDGET_MS" \
      "$READY_FIX_300_DARWIN_MEDIAN_BUDGET_MS")
    _assert_ms_le "ready --fix perf: 300-file median" \
      "$__PERF_MEDIAN" "$ready_fix_median_budget"
  fi
done

_test_summary
