#!/usr/bin/env bash
# sley-performance-test - guard the shape of latency-sensitive workflow paths.

set -euo pipefail

SLEY_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
SLEY_REPO_ROOT="$(cd -- "$SLEY_TEST_DIR/.." && pwd -P)"
SLEY="$SLEY_REPO_ROOT/bin/sley"

# shellcheck source=../helpers.sh
. "$SLEY_TEST_DIR/helpers.sh"

SLEY_PERF_RUNS=${SLEY_PERF_RUNS:-7}
SLEY_HOOK_PERF_RUNS=${SLEY_HOOK_PERF_RUNS:-20}
SLEY_READY_FIX_PERF_RUNS=${SLEY_READY_FIX_PERF_RUNS:-3}
SLEY_PERF_CHANGED_FILES=${SLEY_PERF_CHANGED_FILES:-300}
SLEY_LINT_IGNORE_PERF_FILES=${SLEY_LINT_IGNORE_PERF_FILES:-5000}
SLEY_LINT_IGNORE_PERF_RUNS=${SLEY_LINT_IGNORE_PERF_RUNS:-3}
SLEY_PERF_BUDGET_MULTIPLIER_ENV=SLEY_PERF_BUDGET_MULTIPLIER

# These measure user-visible CLI paths, including repo detection, changed-file
# discovery, JSON command grouping, hook dispatch, and process startup. They are
# intentionally not microbenchmarks; hooks and agent workflows pay the full cost.
VERIFY_DISCOVERY_MEDIAN_BUDGET_MS=2500
VERIFY_DISCOVERY_DARWIN_MEDIAN_BUDGET_MS=3500
VERIFY_DISCOVERY_MAX_BUDGET_MS=9000
VERIFY_DISCOVERY_DARWIN_MAX_BUDGET_MS=12000
VERIFY_REQUIRED_REGISTRY_MEDIAN_BUDGET_MS=2500
VERIFY_REQUIRED_REGISTRY_DARWIN_MEDIAN_BUDGET_MS=3500
VERIFY_REQUIRED_REGISTRY_MAX_BUDGET_MS=9000
VERIFY_REQUIRED_REGISTRY_DARWIN_MAX_BUDGET_MS=12000
HOOK_FORMAT_FILE_MEDIAN_BUDGET_MS=350
HOOK_FORMAT_FILE_DARWIN_MEDIAN_BUDGET_MS=500
HOOK_FORMAT_FILE_P95_BUDGET_MS=1000
HOOK_FORMAT_FILE_DARWIN_P95_BUDGET_MS=1500
HOOK_LINT_FILE_MEDIAN_BUDGET_MS=350
HOOK_LINT_FILE_DARWIN_MEDIAN_BUDGET_MS=500
HOOK_LINT_FILE_P95_BUDGET_MS=1000
HOOK_LINT_FILE_DARWIN_P95_BUDGET_MS=1500
LINT_IGNORE_5000_MEDIAN_BUDGET_MS=1000
LINT_IGNORE_5000_DARWIN_MEDIAN_BUDGET_MS=1800
CHECK_2_MEDIAN_BUDGET_MS=500
CHECK_2_DARWIN_MEDIAN_BUDGET_MS=750
CHECK_2_P95_BUDGET_MS=1500
CHECK_2_DARWIN_P95_BUDGET_MS=2000
CHECK_300_MEDIAN_BUDGET_MS=1200
CHECK_300_DARWIN_MEDIAN_BUDGET_MS=1800
CHECK_300_P95_BUDGET_MS=3500
CHECK_300_DARWIN_P95_BUDGET_MS=5000
READY_FIX_300_MEDIAN_BUDGET_MS=5000
READY_FIX_300_DARWIN_MEDIAN_BUDGET_MS=7000
READY_FIX_FORMAT_CHUNK_FILES=256
FIX_FORMAT_CHUNK_FILES=256

perf_mock_bin=$(_mock_bin)
cat >"$perf_mock_bin/checkrun" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "capabilities" && "${2:-}" == "--has" &&
  "${3:-}" == "autolint-files0-stdin" ]]; then
  : "${SLEY_PERF_CHECKRUN_CAPABILITY_COUNT_FILE:?}"
  count=$(cat "$SLEY_PERF_CHECKRUN_CAPABILITY_COUNT_FILE")
  printf '%s\n' "$((count + 1))" >"$SLEY_PERF_CHECKRUN_CAPABILITY_COUNT_FILE"
  exit "${SLEY_PERF_CHECKRUN_CAPABILITY_RC:-0}"
fi

: "${SLEY_PERF_CHECKRUN_COUNT_FILE:?}"
: "${SLEY_PERF_CHECKRUN_ARGS_PREFIX:?}"
: "${SLEY_PERF_CHECKRUN_HOME_PREFIX:?}"

count=$(cat "$SLEY_PERF_CHECKRUN_COUNT_FILE")
count=$((count + 1))
printf '%s\n' "$count" >"$SLEY_PERF_CHECKRUN_COUNT_FILE"
printf '%s\n' "$@" >"${SLEY_PERF_CHECKRUN_ARGS_PREFIX}.${count}"
printf '%s\n' "$HOME" >"${SLEY_PERF_CHECKRUN_HOME_PREFIX}.${count}"
EOF
cat >"$perf_mock_bin/autoformat" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

: "${SLEY_PERF_AUTOFORMAT_COUNT_FILE:?}"
: "${SLEY_PERF_AUTOFORMAT_ARGS_PREFIX:?}"

count=$(cat "$SLEY_PERF_AUTOFORMAT_COUNT_FILE")
count=$((count + 1))
printf '%s\n' "$count" >"$SLEY_PERF_AUTOFORMAT_COUNT_FILE"
printf '%s\n' "$@" >"${SLEY_PERF_AUTOFORMAT_ARGS_PREFIX}.${count}"
exit "${SLEY_PERF_AUTOFORMAT_RC:-0}"
EOF
cat >"$perf_mock_bin/autolint" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

: "${SLEY_PERF_AUTOLINT_COUNT_FILE:?}"
: "${SLEY_PERF_AUTOLINT_ARGS_PREFIX:?}"

count=$(cat "$SLEY_PERF_AUTOLINT_COUNT_FILE")
count=$((count + 1))
printf '%s\n' "$count" >"$SLEY_PERF_AUTOLINT_COUNT_FILE"
if [[ "${1:-}" == "--files0-from" && "${2:-}" == "-" ]]; then
  printf '%s\n' --files0-from >"${SLEY_PERF_AUTOLINT_ARGS_PREFIX}.${count}"
  while IFS= read -r -d '' file; do
    printf '%s\n' "$file" >>"${SLEY_PERF_AUTOLINT_ARGS_PREFIX}.${count}"
  done
else
  printf '%s\n' "$@" >"${SLEY_PERF_AUTOLINT_ARGS_PREFIX}.${count}"
fi
exit "${SLEY_PERF_AUTOLINT_RC:-0}"
EOF
cat >"$perf_mock_bin/getconf" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  ARG_MAX) printf '131072\n' ;;
  _NPROCESSORS_ONLN) printf '4\n' ;;
  *) exit 1 ;;
esac
EOF
SLEY_PERF_SYSTEM_ENV=$(command -v env)
export SLEY_PERF_SYSTEM_ENV
cat >"$perf_mock_bin/env" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "${SLEY_PERF_MANY_ENV_ENTRIES:-0}" == "1" ]]; then
  # Keep the string bytes modest while reproducing the envp pointer pressure
  # that is otherwise easy to miss when estimating exec's complete payload.
  for ((i = 0; i < 6004; i++)); do
    printf 'E%s=x\n' "$i"
  done
  exit 0
fi

exec "$SLEY_PERF_SYSTEM_ENV" "$@"
EOF
chmod +x "$perf_mock_bin/checkrun" "$perf_mock_bin/autoformat" \
  "$perf_mock_bin/autolint" "$perf_mock_bin/getconf" "$perf_mock_bin/env"
export PATH="$perf_mock_bin:$PATH"

_new_perf_repo() {
  local repo
  repo=$(_tmpdir)
  (
    cd "$repo" || exit 1
    export GIT_CONFIG_GLOBAL="$repo/.gitconfig-test"
    : >"$GIT_CONFIG_GLOBAL"
    git init -q
    git config user.email test@test.local
    git config user.name "Test User"
    mkdir -p "$repo/.hooks"
    git config core.hooksPath "$repo/.hooks"
    git config commit.gpgsign false
  )
  (cd "$repo" && pwd -P)
}

_perf_budget_ms() {
  local base_ms="$1" darwin_ms="${2:-}" multiplier
  if [[ "$(uname -s)" == "Darwin" && -n "$darwin_ms" ]]; then
    base_ms="$darwin_ms"
  fi
  multiplier="${!SLEY_PERF_BUDGET_MULTIPLIER_ENV:-1}"
  if ! [[ "$multiplier" =~ ^[1-9][0-9]*$ ]]; then
    multiplier=1
  fi
  printf '%s\n' "$((base_ms * multiplier))"
}

_assert_ms_le() {
  local desc="$1" actual_ms="$2" budget_ms="$3"
  if [[ "$actual_ms" -le "$budget_ms" ]]; then
    _pass "$desc (${actual_ms}ms <= ${budget_ms}ms)"
  else
    _fail "$desc (${actual_ms}ms > ${budget_ms}ms)"
  fi
}

_assert_file_matches() {
  local desc="$1" expected="$2" actual="$3" expected_content actual_content
  if [[ ! -f "$expected" || ! -f "$actual" ]]; then
    _fail "$desc (file missing: $expected $actual)"
    return
  fi
  expected_content=$(<"$expected")
  actual_content=$(<"$actual")
  if [[ "$expected_content" == "$actual_content" ]]; then
    _pass "$desc"
  else
    _fail "$desc (files differ: $expected $actual)"
  fi
}

_assert_checkrun_invocations() {
  local desc="$1" expected_count="$2" expected_args="$3" expected_home="$4" count run
  count=$(cat "$SLEY_PERF_CHECKRUN_COUNT_FILE")
  _assert_eq "$desc count" "$expected_count" "$count"
  for ((run = 1; run <= count; run++)); do
    _assert_file_matches "$desc args $run" \
      "$expected_args" "${SLEY_PERF_CHECKRUN_ARGS_PREFIX}.${run}"
    _assert_file_content "$desc home $run" \
      "$expected_home" "${SLEY_PERF_CHECKRUN_HOME_PREFIX}.${run}"
  done
}

_assert_autoformat_invocations() {
  local desc="$1" expected_count="$2" expected_args="$3" count run
  count=$(cat "$SLEY_PERF_AUTOFORMAT_COUNT_FILE")
  _assert_eq "$desc count" "$expected_count" "$count"
  for ((run = 1; run <= count; run++)); do
    _assert_file_matches "$desc args $run" \
      "$expected_args" "${SLEY_PERF_AUTOFORMAT_ARGS_PREFIX}.${run}"
  done
}

_assert_autolint_invocations() {
  local desc="$1" expected_count="$2" expected_args="$3" count run
  count=$(cat "$SLEY_PERF_AUTOLINT_COUNT_FILE")
  _assert_eq "$desc count" "$expected_count" "$count"
  for ((run = 1; run <= count; run++)); do
    _assert_file_matches "$desc args $run" \
      "$expected_args" "${SLEY_PERF_AUTOLINT_ARGS_PREFIX}.${run}"
  done
}

_assert_autoformat_chunked_invocations() {
  local desc="$1" expected_runs="$2" chunks_per_run="$3" expected_prefix="$4"
  local count run chunk invocation expected_count
  count=$(cat "$SLEY_PERF_AUTOFORMAT_COUNT_FILE")
  expected_count=$((expected_runs * chunks_per_run))
  _assert_eq "$desc count" "$expected_count" "$count"
  for ((run = 1; run <= expected_runs; run++)); do
    for ((chunk = 1; chunk <= chunks_per_run; chunk++)); do
      invocation=$(((run - 1) * chunks_per_run + chunk))
      _assert_file_matches "$desc run $run chunk $chunk" \
        "$expected_prefix.$chunk" \
        "${SLEY_PERF_AUTOFORMAT_ARGS_PREFIX}.${invocation}"
    done
  done
}

_p95_ms() {
  local runs="$1" index
  index=$(((runs * 95 + 99) / 100))
  sed -n "${index}p"
}

_median_ms() {
  local runs="$1"
  awk -v runs="$runs" '
    NR == int((runs + 1) / 2) { lower = $1 }
    NR == int((runs + 2) / 2) { upper = $1 }
    END { print int((lower + upper) / 2) }
  '
}

_run_perf_sley_timed() {
  local timeout_secs="$1" repo="$2"
  shift 2
  local home xdg_config_home xdg_cache_home output_file rc_file
  home="$repo/.home"
  xdg_config_home="$repo/.xdg-config"
  xdg_cache_home="$repo/.xdg-cache"
  output_file="$repo/.sley-perf-output"
  rc_file="$repo/.sley-perf-rc"
  mkdir -p "$home" "$xdg_config_home" "$xdg_cache_home"
  __SLEY_MS=$(
    cd "$repo" &&
      HOME="$home" \
        XDG_CONFIG_HOME="$xdg_config_home" \
        XDG_CACHE_HOME="$xdg_cache_home" \
        GIT_CONFIG_GLOBAL="$repo/.gitconfig-test" \
        python3 - "$timeout_secs" "$output_file" "$rc_file" "$SLEY" "$@" <<'PY'
import os
import subprocess
import sys
import time

timeout = float(sys.argv[1])
output_file = sys.argv[2]
rc_file = sys.argv[3]
cmd = sys.argv[4:]
input_path = os.environ.get("SLEY_PERF_STDIN_FILE")
input_handle = open(input_path, "r", encoding="utf-8") if input_path else None

started = time.perf_counter_ns()
try:
    try:
        completed = subprocess.run(
            cmd,
            stdin=input_handle,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=timeout,
            env=os.environ.copy(),
        )
        rc = completed.returncode
        output = completed.stdout
    except subprocess.TimeoutExpired as exc:
        rc = 124
        output = exc.stdout or ""
        if isinstance(output, bytes):
            output = output.decode(errors="replace")
finally:
    if input_handle is not None:
        input_handle.close()

elapsed_ms = max(1, (time.perf_counter_ns() - started) // 1_000_000)
with open(output_file, "w", encoding="utf-8") as handle:
    handle.write(output)
with open(rc_file, "w", encoding="utf-8") as handle:
    handle.write(str(rc))
print(elapsed_ms)
PY
  )
  __SLEY_OUT=$(cat "$output_file")
  __SLEY_RC=$(cat "$rc_file")
}

_measure_perf_stats() {
  local desc="$1" timeout_secs="$2" repo="$3" runs="$4"
  shift 4
  local durations_file sorted_file run
  durations_file="$repo/.sley-perf-durations"
  sorted_file="$durations_file.sorted"
  : >"$durations_file"
  for run in $(seq 1 "$runs"); do
    _run_perf_sley_timed "$timeout_secs" "$repo" "$@"
    if [[ "$__SLEY_RC" -ne 0 ]]; then
      _fail "$desc sample $run exits 0 (got $__SLEY_RC; output: $__SLEY_OUT)"
      return 1
    fi
    printf '%s\n' "$__SLEY_MS" >>"$durations_file"
  done
  LC_ALL=C sort -n "$durations_file" >"$sorted_file"
  __PERF_MEDIAN=$(_median_ms "$runs" <"$sorted_file")
  __PERF_P95=$(_p95_ms "$runs" <"$sorted_file")
  __PERF_MAX=$(tail -n 1 "$sorted_file")
}

_should_confirm_perf() {
  local platform="$1" median_ms="$2" maximum_ms="$3"
  local median_budget_ms="$4" maximum_budget_ms="$5"
  [[ "$platform" == "Darwin" ]] &&
    ((median_ms > median_budget_ms && maximum_ms <= maximum_budget_ms))
}

# Decide persistence by batch majority rather than by pooling raw samples.
# Pooling lets the distributions overlap and can invert which batches passed.
_combine_perf_batches() {
  local runs_per_batch="$1" combined_file="$2"
  shift 2
  local batch_count="$#" total_runs sorted_file batch_file
  local batch_sorted_file batch_medians_file batch_medians_sorted_file
  total_runs=$((runs_per_batch * batch_count))
  sorted_file="$combined_file.sorted"
  batch_sorted_file="$combined_file.batch.sorted"
  batch_medians_file="$combined_file.medians"
  batch_medians_sorted_file="$batch_medians_file.sorted"
  : >"$combined_file"
  : >"$batch_medians_file"
  for batch_file in "$@"; do
    cat "$batch_file" >>"$combined_file"
    LC_ALL=C sort -n "$batch_file" >"$batch_sorted_file"
    _median_ms "$runs_per_batch" <"$batch_sorted_file" \
      >>"$batch_medians_file"
  done
  LC_ALL=C sort -n "$combined_file" >"$sorted_file"
  LC_ALL=C sort -n "$batch_medians_file" >"$batch_medians_sorted_file"
  __PERF_MEDIAN=$(_median_ms "$batch_count" <"$batch_medians_sorted_file")
  __PERF_MAX=$(tail -n 1 "$sorted_file")
  __PERF_RUNS="$total_runs"
}

echo "=== sley: performance confirmation policy ==="

if _should_confirm_perf Darwin 4156 4747 3500 12000; then
  _pass "perf confirmation: Darwin median-only breach confirms"
else
  _fail "perf confirmation: Darwin median-only breach confirms"
fi
if ! _should_confirm_perf Darwin 4156 13000 3500 12000; then
  _pass "perf confirmation: maximum breach remains final"
else
  _fail "perf confirmation: maximum breach remains final"
fi
if ! _should_confirm_perf Linux 4156 4747 3500 12000; then
  _pass "perf confirmation: non-Darwin breach remains final"
else
  _fail "perf confirmation: non-Darwin breach remains final"
fi

confirmation_policy_dir=$(_tmpdir)
for _ in $(seq 1 7); do
  printf '4000\n' >>"$confirmation_policy_dir/slow"
  printf '3000\n' >>"$confirmation_policy_dir/healthy"
done
printf '3000\n3000\n3000\n4000\n4000\n4000\n4000\n' \
  >"$confirmation_policy_dir/slow-mixed"
printf '3000\n3000\n3000\n3000\n4000\n4000\n4000\n' \
  >"$confirmation_policy_dir/healthy-mixed"
_combine_perf_batches 7 "$confirmation_policy_dir/combined" \
  "$confirmation_policy_dir/slow" \
  "$confirmation_policy_dir/healthy-mixed" \
  "$confirmation_policy_dir/healthy-mixed"
_assert_eq "perf confirmation: one slow batch is outvoted" \
  "3000" "$__PERF_MEDIAN"
_assert_eq "perf confirmation: combined run count is odd" \
  "21" "$__PERF_RUNS"
_assert_eq "perf confirmation: combined maximum is preserved" \
  "4000" "$__PERF_MAX"

_combine_perf_batches 7 "$confirmation_policy_dir/combined" \
  "$confirmation_policy_dir/slow-mixed" \
  "$confirmation_policy_dir/slow-mixed" \
  "$confirmation_policy_dir/healthy"
_assert_eq "perf confirmation: two slow batches remain a breach" \
  "4000" "$__PERF_MEDIAN"

for _ in $(seq 1 6); do
  printf '3200\n' >>"$confirmation_policy_dir/spiky"
done
printf '13000\n' >>"$confirmation_policy_dir/spiky"
_combine_perf_batches 7 "$confirmation_policy_dir/combined" \
  "$confirmation_policy_dir/healthy" \
  "$confirmation_policy_dir/healthy-mixed" \
  "$confirmation_policy_dir/spiky"
_assert_eq "perf confirmation: confirmation maximum remains visible" \
  "13000" "$__PERF_MAX"

_write_changed_tree() {
  local repo="$1" count="$2" i dir file
  dir="$repo/packages/app/src/generated/deep/nested"
  mkdir -p "$dir"
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i.js"
    printf 'export const value%s = %s;\n' "$i" "$i" >"$file"
  done
  (
    cd "$repo" || exit 1
    git add .
    git commit -q -m "seed large verify fixture"
  )
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i.js"
    printf 'export const changed%s = %s;\n' "$i" "$i" >>"$file"
  done
}

_write_long_changed_tree() {
  local repo="$1" count="$2" i dir file long_dir long_leaf
  printf -v long_dir '%0120d' 0
  printf -v long_leaf '%060d' 0
  dir="$repo/packages/$long_dir"
  mkdir -p "$dir"
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i-$long_leaf.sh"
    printf '#!/usr/bin/env bash\nprintf %s before\n' "$i" >"$file"
  done
  (
    cd "$repo" || exit 1
    git add .
    git commit -q -m "seed long lint fixture"
  )
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i-$long_leaf.sh"
    printf 'printf %s after\n' "$i" >>"$file"
  done
}

_write_staged_changed_tree() {
  local repo="$1" count="$2" i dir file
  dir="$repo/staged"
  mkdir -p "$dir"
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i.txt"
    printf 'base %s\n' "$i" >"$file"
  done
  (
    cd "$repo" || exit 1
    git add staged
    git commit -q -m "seed staged ready fixture"
  )
  for i in $(seq 1 "$count"); do
    file="$dir/file-$i.txt"
    printf 'changed %s\n' "$i" >>"$file"
  done
  (cd "$repo" && git add staged)
}

echo "=== sley: commit-message secret scan concurrency ==="

# Use a condition barrier rather than elapsed-time comparison. Each scanner
# keeps an active marker only while it is alive and waits for its peer. A serial
# implementation cannot satisfy the condition; a concurrent implementation can
# do so regardless of ordinary runner-speed variance.
repo=$(_new_perf_repo)
message_mock_bin=$(_mock_bin)
message_state=$(_tmpdir)
message_extensions=$(_tmpdir)
message_config="$repo/extra-policy.toml"
: >"$message_config"
cat >"$message_extensions/80-extra.sh" <<EOF
_sley_hook_secrets_extra_configs() { printf '%s\n' '$message_config'; }
EOF
cat >"$message_mock_bin/gitleaks" <<'EOF'
#!/usr/bin/env bash
set -u

label=base
case " $* " in
  *" --config "*) label=extra ;;
esac
active="$SLEY_PERF_MESSAGE_STATE/active.$label"
: >"$active"
trap 'rm -f -- "$active"' EXIT

attempt=0
while [[ ! -f "$SLEY_PERF_MESSAGE_STATE/active.base" ||
  ! -f "$SLEY_PERF_MESSAGE_STATE/active.extra" ]]; do
  attempt=$((attempt + 1))
  [[ "$attempt" -lt 500 ]] || exit 70
  sleep 0.01
done
: >"$SLEY_PERF_MESSAGE_STATE/ready.$label"
attempt=0
while [[ ! -f "$SLEY_PERF_MESSAGE_STATE/ready.base" ||
  ! -f "$SLEY_PERF_MESSAGE_STATE/ready.extra" ]]; do
  attempt=$((attempt + 1))
  [[ "$attempt" -lt 500 ]] || exit 71
  sleep 0.01
done
cat >"$SLEY_PERF_MESSAGE_STATE/input.$label"
EOF
chmod +x "$message_mock_bin/gitleaks"
export SLEY_PERF_MESSAGE_STATE="$message_state"
printf 'ordinary message\n' >"$repo/message"
PATH="$message_mock_bin:$PATH" \
  SLEY_EXTENSION_DIR="$message_extensions" SLEY_SECRETS_JOBS=2 \
  _run_perf_sley_timed 10 "$repo" secrets --message-file "$repo/message"
_assert_exit "message secrets perf: independent policies overlap" 0 "$__SLEY_RC"
_assert_file_content "message secrets perf: base receives the message" \
  "ordinary message" "$message_state/input.base"
_assert_file_content "message secrets perf: extra policy receives the message" \
  "ordinary message" "$message_state/input.extra"

echo "=== sley: verify performance ==="

repo=$(_new_perf_repo)
config_scan_state=$(_tmpdir)
config_scan_log="$config_scan_state/scanned-dirs"
config_scan_expected="$config_scan_state/expected-dirs"
: >"$config_scan_log"
printf '%s\n' \
  packages/app/src/generated/deep/nested \
  packages/app/src/generated/deep \
  packages/app/src/generated \
  packages/app/src \
  packages/app \
  packages \
  . >"$config_scan_expected"
config_scan_files=""
for i in $(seq 1 "$SLEY_PERF_CHANGED_FILES"); do
  config_scan_files+="packages/app/src/generated/deep/nested/file-$i.js"$'\n'
done
(
  cd "$repo" || exit 1
  # shellcheck source=../../lib/sley/verify.sh
  source "$SLEY_REPO_ROOT/lib/sley/verify.sh"
  _REPO_ROOT="$repo"
  # shellcheck disable=SC2329 # Invoked indirectly by the sourced config walker.
  _sley_verify_repo_config_dir_files() {
    printf '%s\n' "$1" >>"$config_scan_log"
  }
  _sley_verify_repo_config_files "$config_scan_files" >/dev/null
)
_assert_file_matches \
  "verify perf: shared subtree scans each config directory once" \
  "$config_scan_expected" "$config_scan_log"

repo=$(_new_perf_repo)
mkdir -p "$repo/packages/app"
cat >"$repo/package.json" <<'EOF'
{"scripts":{"test":"node root-test.js","lint":"node root-lint.js"}}
EOF
cat >"$repo/packages/app/package.json" <<'EOF'
{"scripts":{"test":"node app-test.js","lint":"node app-lint.js","build":"node app-build.js"}}
EOF
_write_changed_tree "$repo" "$SLEY_PERF_CHANGED_FILES"

_run_perf_sley_timed 15 "$repo" verify --json
_assert_exit "verify perf: large shared subtree discovery exits 0" 0 "$__SLEY_RC"
_assert_contains "verify perf: discovers ancestor manifest command" "node app-test.js" "$__SLEY_OUT"
_assert_contains "verify perf: discovers repo-root manifest command" "node root-test.js" "$__SLEY_OUT"
_measure_perf_stats "verify perf: large shared subtree discovery" 15 "$repo" \
  "$SLEY_PERF_RUNS" verify --json
discovery_median="$__PERF_MEDIAN"
discovery_max="$__PERF_MAX"
