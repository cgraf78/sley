#!/usr/bin/env bash
# Verify that the PATH-visible workflow command has a manual page.

set -o pipefail
export NO_COLOR=1

SLEY_TEST_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
SLEY_REPO_ROOT="$(cd -- "$SLEY_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$SLEY_TEST_DIR/helpers.sh"

echo "=== sley: manpages ==="

_check_command_pages() {
  local inventory path command page content
  inventory=$(_tmpdir) || return
  inventory="$inventory/commands"
  git -C "$SLEY_REPO_ROOT" ls-files -z -- 'bin/*' >"$inventory" || return
  [[ -s "$inventory" ]] || return 1
  while IFS= read -r -d '' path; do
    command=${path##*/}
    page="$SLEY_REPO_ROOT/man/man1/$command.1"
    _assert_file_exists "manpage exists: $command" "$page"
    content=$(cat "$page")
    _assert_contains "manpage NAME section: $command" ".SH NAME" "$content"
    _assert_contains "manpage names command: $command" "$command \\" "$content"
  done <"$inventory"
}

_check_command_pages || _fail "manpage inventory: cannot enumerate tracked commands"
probe_status=0
probe_output=$(
  # shellcheck disable=SC2329 # Used by _check_command_pages below.
  git() {
    printf '%s\0' bin/sley
    return 17
  }
  _check_command_pages
) || probe_status=$?
_assert_exit "manpage inventory: propagates a failed Git listing" 17 "$probe_status"
_assert_eq "manpage inventory: does not check partial Git output" "" "$probe_output"

content=$(cat "$SLEY_REPO_ROOT/man/man1/sley.1")
_assert_contains "manpage documents verify bridge" "Checkrun verify bridge" "$content"

readme_content=$(cat "$SLEY_REPO_ROOT/README.md")
_assert_contains "README documents ready process-group boundary" \
  "managed process group through completion" "$readme_content"
_assert_contains "README assigns detached process cleanup to extension authors" \
  "cleanup remains the extension author's responsibility" "$readme_content"
_assert_contains "manpage documents ready process-group boundary" \
  "managed process group through completion" "$content"
_assert_contains "manpage assigns detached process cleanup to extension authors" \
  "cleanup remains the extension author's responsibility" "$content"

_test_summary
