    if [[ "${SLEY_SECRETS_TEST_FAILURE_OUTPUT:-0}" == 1 ]]; then
      printf 'combined-stdout-first\n'
      printf 'combined-stderr-second\n' >&2
      printf 'combined-stdout-third\n'
