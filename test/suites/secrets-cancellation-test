if [[ "${SLEY_SECRETS_TEST_FUNCTION_OVERRIDE:-0}" == 1 ]]; then
  gitleaks() {
    local label="" status=0
    local arg
    for arg in "$@"; do
      label="${arg##*/}"
    done
    if ! mkdir "$SLEY_SECRETS_TEST_SYNC/function.active" 2>/dev/null; then
      : >"$SLEY_SECRETS_TEST_SYNC/function.overlap"
    fi
    printf '%s\n' "$BASHPID" >"$SLEY_SECRETS_TEST_SYNC/started.$label"
    IFS= read -r -n 1 _ <"$SLEY_SECRETS_TEST_SYNC/release.$label"
    rmdir "$SLEY_SECRETS_TEST_SYNC/function.active" 2>/dev/null || true
    status="${label%%-*}"
