if [[ "${SLEY_SECRETS_TEST_RECORD_ALLOCATION_COUNT:-0}" == 1 ]]; then
  eval "$(declare -f _sley_secrets_parallel_allocate_directory | sed '1s/_sley_secrets_parallel_allocate_directory/_sley_secrets_parallel_allocate_directory_original/')"
  _sley_secrets_parallel_allocate_directory() {
