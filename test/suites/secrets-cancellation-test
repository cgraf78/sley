#!/usr/bin/env bash
# Parent-only signal and lifecycle coverage for parallel secret scans.

set -uo pipefail

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
root="${test_dir%/test}"

# shellcheck source=../helpers.sh
source "$test_dir/helpers.sh"

if ! command -v python3 >/dev/null 2>&1; then
  echo "SKIP: secrets-cancellation-test (python3 unavailable)"
  exit 0
fi

fixture=$(_tmpdir)
orchestrator="$fixture/orchestrator.py"

cat >"$orchestrator" <<'PY'
from __future__ import annotations

import errno
import fcntl
import os
import pathlib
import signal
import shlex
import shutil
import subprocess
import sys
import tempfile
import termios
import time


ROOT = pathlib.Path(sys.argv[1])
BASE = pathlib.Path(sys.argv[2])
SCENARIO = sys.argv[3]
PYTHON = sys.executable


def wait_for(predicate, description: str, timeout: float = 8.0) -> None:
    deadline = time.monotonic() + timeout
    while not predicate():
        if time.monotonic() >= deadline:
            raise AssertionError(f"timed out waiting for {description}")
        time.sleep(0.01)


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def process_in_session(pid: int, session: int) -> bool:
    try:
        return os.getsid(pid) == session
    except ProcessLookupError:
        return False


def process_is_zombie(pid: int) -> bool:
    # Linux containers commonly run a minimal PID 1 that does not promptly
    # reap adopted children. After this harness kills an orphan from a driver
    # that intentionally exited early, `/proc` can therefore retain a zombie:
    # execution has ended, but only PID 1 is allowed to perform the final wait.
    # Keep this check Linux-specific and conservative; on platforms without
    # procfs, the existing session lookup remains the authoritative signal.
    try:
        status = pathlib.Path(f"/proc/{pid}/status").read_text(encoding="ascii")
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return False
    for line in status.splitlines():
        if line.startswith("State:"):
            fields = line.split()
            return len(fields) >= 2 and fields[1] == "Z"
    return False


def live_process_in_session(pid: int, session: int) -> bool:
    return process_in_session(pid, session) and not process_is_zombie(pid)


class ExpectedEarlyExit(Exception):
    pass


def read_result(path: pathlib.Path) -> dict[str, str]:
    result: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        key, value = line.split("=", 1)
        result[key] = value
    return result


def output_text(value: str | bytes | None) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return value


def reset_child_signals() -> None:
    os.setsid()
    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, signal.SIG_DFL)


def prepare_interactive_child() -> None:
    reset_child_signals()
    # `bash -i` only enables real job-control behavior when stdin is the
    # controlling terminal for its new session. Without TIOCSCTTY this would
    # be another synthetic `set -m` test and miss asynchronous notifications.
    fcntl.ioctl(0, termios.TIOCSCTTY, 0)


def write_executable(path: pathlib.Path, body: str) -> None:
    path.write_text(body, encoding="utf-8")
    path.chmod(0o755)


def make_repo(case_dir: pathlib.Path, labels: list[str]) -> pathlib.Path:
    repo = case_dir / "repo"
    repo.mkdir()
    subprocess.run(["git", "init", "-q", str(repo)], check=True)
    subprocess.run(["git", "-C", str(repo), "config", "user.email", "test@example.invalid"], check=True)
    subprocess.run(["git", "-C", str(repo), "config", "user.name", "Sley Test"], check=True)
    subprocess.run(["git", "-C", str(repo), "config", "core.hooksPath", "/dev/null"], check=True)
    subprocess.run(["git", "-C", str(repo), "config", "commit.gpgsign", "false"], check=True)
    for label in labels:
        (repo / label).write_text("before\n", encoding="utf-8")
    subprocess.run(["git", "-C", str(repo), "add", "--", *labels], check=True)
    subprocess.run(["git", "-C", str(repo), "commit", "-q", "-m", "seed"], check=True)
    for label in labels:
        with (repo / label).open("a", encoding="utf-8") as handle:
            handle.write("after\n")
    return repo


