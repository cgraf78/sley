if [[ "${SLEY_SECRETS_TEST_RESOLUTION_FAILURE:-0}" == 1 ]]; then
  # Production deliberately bypasses a caller's `type` function. Intercept
  # the builtin dispatch one level lower so this fixture still exercises the
  # narrow race where an executable disappears between classification and
  # path resolution, without weakening the caller-shadow regression coverage.
  builtin() {
    if [[ "${1:-}" == type && "${2:-}" == -P &&
      "${3:-}" == gitleaks ]]; then
      return 1
    fi
    command builtin "$@"
