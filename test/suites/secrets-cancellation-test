#!/usr/bin/env bash
# Parent-only signal and lifecycle coverage for parallel secret scans.

set -uo pipefail

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
root="${test_dir%/test}"

# shellcheck source=../helpers.sh
source "$test_dir/helpers.sh"

if ! command -v python3 >/dev/null 2>&1; then
  echo "SKIP: secrets-cancellation-test (python3 unavailable)"
  exit 0
fi

fixture=$(_tmpdir)
orchestrator="$fixture/orchestrator.py"

cat >"$orchestrator" <<'PY'
from __future__ import annotations

import errno
import os
import pathlib
import signal
import shlex
import subprocess
import sys
import tempfile
import time


ROOT = pathlib.Path(sys.argv[1])
BASE = pathlib.Path(sys.argv[2])
SCENARIO = sys.argv[3]
PYTHON = sys.executable


def wait_for(predicate, description: str, timeout: float = 8.0) -> None:
    deadline = time.monotonic() + timeout
    while not predicate():
        if time.monotonic() >= deadline:
            raise AssertionError(f"timed out waiting for {description}")
        time.sleep(0.01)


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def process_in_session(pid: int, session: int) -> bool:
    try:
        return os.getsid(pid) == session
    except ProcessLookupError:
        return False


class ExpectedEarlyExit(Exception):
    pass


def read_result(path: pathlib.Path) -> dict[str, str]:
    result: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        key, value = line.split("=", 1)
        result[key] = value
    return result


def output_text(value: str | bytes | None) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return value


def reset_child_signals() -> None:
    os.setsid()
    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, signal.SIG_DFL)


def write_executable(path: pathlib.Path, body: str) -> None:
    path.write_text(body, encoding="utf-8")
    path.chmod(0o755)


def make_repo(case_dir: pathlib.Path, labels: list[str]) -> pathlib.Path:
    repo = case_dir / "repo"
    repo.mkdir()
    subprocess.run(["git", "init", "-q", str(repo)], check=True)
    subprocess.run(["git", "-C", str(repo), "config", "user.email", "test@example.invalid"], check=True)
    subprocess.run(["git", "-C", str(repo), "config", "user.name", "Sley Test"], check=True)
    subprocess.run(["git", "-C", str(repo), "config", "core.hooksPath", "/dev/null"], check=True)
    subprocess.run(["git", "-C", str(repo), "config", "commit.gpgsign", "false"], check=True)
    for label in labels:
        (repo / label).write_text("before\n", encoding="utf-8")
    subprocess.run(["git", "-C", str(repo), "add", "--", *labels], check=True)
    subprocess.run(["git", "-C", str(repo), "commit", "-q", "-m", "seed"], check=True)
    for label in labels:
        with (repo / label).open("a", encoding="utf-8") as handle:
            handle.write("after\n")
    return repo


MOCK_GITLEAKS = r'''import os
import pathlib
import signal
import sys

sync = pathlib.Path(os.environ["SLEY_SECRETS_TEST_SYNC"])
label = pathlib.Path(sys.argv[-1]).name
mode = os.environ.get("SLEY_SECRETS_TEST_TERM", "cooperate")

if "--config" in sys.argv:
    (sync / "extra-config-started").touch(exist_ok=True)
    raise SystemExit(0)


def on_term(_signum, _frame):
    with (sync / f"term.{label}").open("a", encoding="ascii") as handle:
        handle.write(f"{os.getpid()}\n")
    if mode == "cooperate":
        raise SystemExit(0)


if mode == "ignore":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
else:
    signal.signal(signal.SIGTERM, on_term)

(sync / f"started.{label}").write_text(str(os.getpid()), encoding="ascii")
with (sync / f"release.{label}").open("rb", buffering=0) as gate:
    gate.read(1)

print(f"stdout:{label}")
print(f"stderr:{label}", file=sys.stderr)
(sync / f"finished.{label}").write_text("done", encoding="ascii")
try:
    status = int(label.split("-", 1)[0])
except ValueError:
    status = 0
raise SystemExit(status)
'''


DRIVER = r'''#!/usr/bin/env bash
set +e
set -o pipefail
set +m
shopt -s nullglob

cd "$SLEY_SECRETS_TEST_REPO" || exit 90
# shellcheck source=/dev/null
source "$SLEY_SECRETS_TEST_LIB"

if [[ "${SLEY_SECRETS_TEST_FUNCTION_OVERRIDE:-0}" == 1 ]]; then
  gitleaks() {
    local label="" status=0
    local arg
    for arg in "$@"; do
      label="${arg##*/}"
    done
    if ! mkdir "$SLEY_SECRETS_TEST_SYNC/function.active" 2>/dev/null; then
      : >"$SLEY_SECRETS_TEST_SYNC/function.overlap"
    fi
    printf '%s\n' "$BASHPID" >"$SLEY_SECRETS_TEST_SYNC/started.$label"
    IFS= read -r -n 1 _ <"$SLEY_SECRETS_TEST_SYNC/release.$label"
    rmdir "$SLEY_SECRETS_TEST_SYNC/function.active" 2>/dev/null || true
    status="${label%%-*}"
    [[ "$status" == *[!0-9]* ]] && status=0
    return "$status"
  }
fi

if [[ "${SLEY_SECRETS_TEST_RESOLUTION_FAILURE:-0}" == 1 ]]; then
  type() {
    if [[ "${1:-}" == -P && "${2:-}" == gitleaks ]]; then
      return 1
    fi
    builtin type "$@"
  }
fi

if [[ "${SLEY_SECRETS_TEST_LOG_KILL:-0}" == 1 ]]; then
  kill() {
    printf '%s\n' "$*" >>"$SLEY_SECRETS_TEST_SYNC/kill.log"
    builtin kill "$@"
  }
fi

if [[ "${SLEY_SECRETS_TEST_REJECT_CAT:-0}" == 1 ]]; then
  # A terminal signal cannot be handled by the sourced parent while it waits
  # for an unrelated foreground diagnostic process. Keep replay in-process.
  sley_secrets_test_real_cat=$(type -P cat)
  cat() {
    case " ${FUNCNAME[*]} " in
      *" _sley_secrets_print_failed_scan_output "*)
        : >"$SLEY_SECRETS_TEST_SYNC/cat-invoked"
        ;;
    esac
    "$sley_secrets_test_real_cat" "$@"
  }
fi

if [[ "${SLEY_SECRETS_TEST_SIGNAL_BEFORE_WAIT:-0}" == 1 ]]; then
  wait_signal_fired=0
  wait() {
    if [[ "$wait_signal_fired" -eq 0 ]]; then
      wait_signal_fired=1
      : >"$SLEY_SECRETS_TEST_SYNC/signal-before-wait"
      builtin kill -TERM "$BASHPID"
    fi
    builtin wait "$@"
  }
fi

if [[ "${SLEY_SECRETS_TEST_SIGNAL_DURING_CLEANUP:-0}" == 1 ]]; then
  cleanup_output_calls=0
  eval "$(declare -f _sley_secrets_parallel_remove_files | sed '1s/_sley_secrets_parallel_remove_files/_sley_secrets_parallel_remove_files_original/')"
  eval "$(declare -f _sley_secrets_parallel_remove_output | sed '1s/_sley_secrets_parallel_remove_output/_sley_secrets_parallel_remove_output_original/')"
  _sley_secrets_parallel_remove_files() {
    if [[ ! -e "$SLEY_SECRETS_TEST_SYNC/remove-files-failed" ]]; then
      : >"$SLEY_SECRETS_TEST_SYNC/remove-files-failed"
      return 73
    fi
    _sley_secrets_parallel_remove_files_original "$@"
  }
  _sley_secrets_parallel_remove_output() {
    cleanup_output_calls=$((cleanup_output_calls + 1))
    if [[ "$cleanup_output_calls" -eq 1 ]]; then
      builtin kill -TERM "$BASHPID"
      : >"$SLEY_SECRETS_TEST_SYNC/signal-during-cleanup"
    fi
    _sley_secrets_parallel_remove_output_original "$@"
  }
fi

if [[ "${SLEY_SECRETS_TEST_SIGNAL_DURING_ALLOCATION:-0}" == 1 ]]; then
  allocation_signal_fired=0
  eval "$(declare -f _sley_secrets_parallel_allocate_directory | sed '1s/_sley_secrets_parallel_allocate_directory/_sley_secrets_parallel_allocate_directory_original/')"
  _sley_secrets_parallel_allocate_directory() {
    local rc=0
    _sley_secrets_parallel_allocate_directory_original "$@" || rc=$?
    if [[ "$rc" -eq 0 && "$allocation_signal_fired" -eq 0 ]]; then
      allocation_signal_fired=1
      builtin kill -TERM "$BASHPID"
    fi
    return "$rc"
  }
fi

if [[ "${SLEY_SECRETS_TEST_CLEANUP_FAILURE:-0}" == 1 ]]; then
  eval "$(declare -f _sley_secrets_parallel_remove_output | sed '1s/_sley_secrets_parallel_remove_output/_sley_secrets_parallel_remove_output_original/')"
  _sley_secrets_parallel_remove_output() {
    local path
    for path in "${_sley_secrets_parallel_output_dirs[@]}"; do
      : >"$path/foreign"
      printf '%s\n' "$path" >"$SLEY_SECRETS_TEST_SYNC/retained-scratch"
    done
    _sley_secrets_parallel_remove_output_original "$@"
  }
fi

"$SLEY_SECRETS_TEST_PYTHON" -c 'import signal; signal.pause()' &
unrelated_pid=$!
printf '%s\n' "$unrelated_pid" >"$SLEY_SECRETS_TEST_SYNC/unrelated.pid"
if [[ "${SLEY_SECRETS_TEST_EARLY_EXIT:-0}" == 1 ]]; then
  exit 91
fi

trap 'printf "HUP\n" >>"$SLEY_SECRETS_TEST_TRAP_LOG"' HUP
trap 'printf "INT\n" >>"$SLEY_SECRETS_TEST_TRAP_LOG"' INT
trap 'printf "TERM\n" >>"$SLEY_SECRETS_TEST_TRAP_LOG"' TERM
before_hup=$(trap -p HUP)
before_int=$(trap -p INT)
before_term=$(trap -p TERM)
before_options=$(set +o)
before_shopt=$(shopt -p || true)
before_pwd=$PWD
export SLEY_SECRETS_TEST_DRIVER_PID=$BASHPID

sley_secrets --repo-wide
operation_rc=$?

after_hup=$(trap -p HUP)
after_int=$(trap -p INT)
after_term=$(trap -p TERM)
after_options=$(set +o)
after_shopt=$(shopt -p || true)
after_pwd=$PWD

traps_restored=no
[[ "$before_hup" == "$after_hup" && "$before_int" == "$after_int" &&
  "$before_term" == "$after_term" ]] && traps_restored=yes
options_restored=no
[[ "$before_options" == "$after_options" ]] && options_restored=yes
shopt_restored=no
[[ "$before_shopt" == "$after_shopt" ]] && shopt_restored=yes
cwd_restored=no
[[ "$before_pwd" == "$after_pwd" ]] && cwd_restored=yes
unrelated_alive=no
kill -0 "$unrelated_pid" 2>/dev/null && unrelated_alive=yes

kill -TERM "$unrelated_pid" 2>/dev/null || true
wait "$unrelated_pid" 2>/dev/null || true

trap_count=0
[[ ! -f "$SLEY_SECRETS_TEST_TRAP_LOG" ]] ||
  trap_count=$(wc -l <"$SLEY_SECRETS_TEST_TRAP_LOG" | tr -d '[:space:]')

result_tmp="$SLEY_SECRETS_TEST_RESULT.tmp"
{
  printf 'rc=%s\n' "$operation_rc"
  printf 'traps_restored=%s\n' "$traps_restored"
  printf 'options_restored=%s\n' "$options_restored"
  printf 'shopt_restored=%s\n' "$shopt_restored"
  printf 'cwd_restored=%s\n' "$cwd_restored"
  printf 'unrelated_alive=%s\n' "$unrelated_alive"
  printf 'caller_trap_count=%s\n' "$trap_count"
} >"$result_tmp"
mv "$result_tmp" "$SLEY_SECRETS_TEST_RESULT"
IFS= read -r _ <"$SLEY_SECRETS_TEST_SYNC/driver-release"
'''


def release(sync: pathlib.Path, label: str) -> None:
    gate = sync / f"release.{label}"
    deadline = time.monotonic() + 8.0
    while True:
        try:
            fd = os.open(gate, os.O_WRONLY | os.O_NONBLOCK)
            break
        except OSError as error:
            if error.errno != errno.ENXIO or time.monotonic() >= deadline:
                raise
            time.sleep(0.01)
    try:
        os.write(fd, b"x")
    finally:
        os.close(fd)


def started_pids(sync: pathlib.Path) -> list[int]:
    pids: list[int] = []
    for path in sync.glob("started.*"):
        contents = path.read_text(encoding="ascii").strip()
        if contents:
            pids.append(int(contents))
    return pids


def run_case() -> None:
    case_dir = pathlib.Path(tempfile.mkdtemp(prefix=f"{SCENARIO}.", dir=BASE))
    sync = case_dir / "sync"
    scratch = case_dir / "scratch"
    bin_dir = case_dir / "bin"
    home = case_dir / "home"
    extensions = case_dir / "extensions"
    sync.mkdir()
    scratch.mkdir()
    bin_dir.mkdir()
    home.mkdir()
    extensions.mkdir()
    os.mkfifo(sync / "driver-release", 0o600)
    global_git_config = home / ".gitconfig"
    global_git_config.touch()

    labels = ["0-a.txt", "0-b.txt", "0-c.txt", "0-d.txt"]
    if SCENARIO == "failure-order":
        labels = ["1-a.txt", "2-b.txt"]
    elif SCENARIO in {
        "allocation-failure",
        "allocation-signal",
        "cleanup-failure",
        "function-fallback",
        "cancel-term-completed",
    }:
        labels = ["0-a.txt", "0-b.txt"]
    elif SCENARIO.startswith("scanner-exit-"):
        labels = [f"{SCENARIO.rsplit('-', 1)[1]}-a.txt"]

    repo = make_repo(case_dir, labels)
    for label in labels:
        os.mkfifo(sync / f"release.{label}", 0o600)

    gitleaks = bin_dir / "gitleaks"
    write_executable(gitleaks, f"#!{PYTHON}\n{MOCK_GITLEAKS}")
    if SCENARIO in {"cancel-term-extra-config", "cancel-term-cleanup"} or SCENARIO.startswith("scanner-exit-"):
        extra_config = case_dir / "extra.toml"
        extra_config.touch()
        (extensions / "10-extra.sh").write_text(
            "_sley_hook_secrets_extra_configs() { printf '%s\\n' "
            f"{shlex.quote(str(extra_config))}; }}\n",
            encoding="utf-8",
        )
    driver = case_dir / "driver.sh"
    write_executable(driver, DRIVER)

    env = os.environ.copy()
    env.update(
        {
            "PATH": f"{bin_dir}:{env['PATH']}",
            "HOME": str(home),
            "GIT_CONFIG_GLOBAL": str(global_git_config),
            "TMPDIR": str(scratch),
            "SLEY_SECRETS_JOBS": "4",
            "SLEY_EXTENSION_DIR": str(extensions),
            "SLEY_SECRETS_TEST_LIB": str(ROOT / "lib/sley/sley.sh"),
            "SLEY_SECRETS_TEST_PYTHON": PYTHON,
            "SLEY_SECRETS_TEST_REPO": str(repo),
            "SLEY_SECRETS_TEST_RESULT": str(sync / "result"),
            "SLEY_SECRETS_TEST_SYNC": str(sync),
            "SLEY_SECRETS_TEST_TRAP_LOG": str(sync / "caller-traps"),
            "SLEY_SECRETS_TEST_TERM": "cooperate",
        }
    )

    if SCENARIO in {"cancel-int-ignore", "first-signal"}:
        env["SLEY_SECRETS_TEST_TERM"] = "ignore" if SCENARIO == "cancel-int-ignore" else "stubborn"
    if SCENARIO == "function-fallback":
        env["SLEY_SECRETS_TEST_FUNCTION_OVERRIDE"] = "1"
    if SCENARIO == "resolution-failure":
        env["SLEY_SECRETS_TEST_RESOLUTION_FAILURE"] = "1"
    if SCENARIO == "cancel-term-completed":
        env["SLEY_SECRETS_TEST_LOG_KILL"] = "1"
    if SCENARIO == "cancel-term-pre-wait":
        env["SLEY_SECRETS_TEST_SIGNAL_BEFORE_WAIT"] = "1"
    if SCENARIO == "cancel-term-cleanup":
        env["SLEY_SECRETS_TEST_SIGNAL_DURING_CLEANUP"] = "1"
    if SCENARIO == "harness-early-exit":
        env["SLEY_SECRETS_TEST_EARLY_EXIT"] = "1"
    if SCENARIO == "allocation-failure":
        env["TMPDIR"] = str(case_dir / "missing" / "tmp")
    if SCENARIO == "allocation-signal":
        env["SLEY_SECRETS_TEST_SIGNAL_DURING_ALLOCATION"] = "1"
    if SCENARIO == "cleanup-failure":
        env["SLEY_SECRETS_TEST_CLEANUP_FAILURE"] = "1"
    if SCENARIO == "failure-order":
        env["SLEY_SECRETS_TEST_REJECT_CAT"] = "1"
    process = subprocess.Popen(
        [str(driver)],
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        preexec_fn=reset_child_signals,
    )
    errors: list[str] = []
    stdout = ""
    stderr = ""
    try:
        wait_for(lambda: (sync / "unrelated.pid").exists(), "unrelated child marker")
        if SCENARIO == "harness-early-exit":
            wait_for(lambda: process.poll() is not None, "intentional early driver exit")
            raise ExpectedEarlyExit

        if SCENARIO == "cancel-term-pre-wait":
            wait_for(
                lambda: (sync / "signal-before-wait").exists(),
                "pre-wait signal injection",
            )
        elif SCENARIO == "cancel-term-cleanup":
            wait_for(lambda: len(list(sync.glob("started.*"))) == len(labels), "all scanner markers")
            for label in labels:
                release(sync, label)
                wait_for(lambda label=label: (sync / f"finished.{label}").exists(), f"{label} completion")
            wait_for(
                lambda: (sync / "signal-during-cleanup").exists(),
                "cleanup signal injection",
            )
        elif SCENARIO == "cancel-term-completed":
            wait_for(lambda: len(list(sync.glob("started.*"))) == len(labels), "all scanner markers")
            completed_label = labels[1]
            release(sync, completed_label)
            wait_for(
                lambda: (sync / f"finished.{completed_label}").exists(),
                "later scanner completion",
            )
            completed_pid = int(
                (sync / f"started.{completed_label}").read_text(encoding="ascii")
            )
            wait_for(
                lambda: not process_exists(completed_pid),
                "later scanner process exit",
            )
            os.kill(process.pid, signal.SIGTERM)
        elif SCENARIO.startswith("cancel-") or SCENARIO == "first-signal":
            wait_for(lambda: len(list(sync.glob("started.*"))) == len(labels), "all scanner markers")
            first_signal = {
                "cancel-hup": signal.SIGHUP,
                "cancel-int-ignore": signal.SIGINT,
                "cancel-term": signal.SIGTERM,
                "cancel-term-extra-config": signal.SIGTERM,
                "first-signal": signal.SIGINT,
            }[SCENARIO]
            os.kill(process.pid, first_signal)
            if SCENARIO == "first-signal":
                try:
                    wait_for(lambda: len(list(sync.glob("term.*"))) > 0, "cooperative TERM attempt")
                except AssertionError as error:
                    errors.append(str(error))
                else:
                    os.kill(process.pid, signal.SIGHUP)
        elif SCENARIO == "function-fallback":
            first = labels[0]
            wait_for(lambda: (sync / f"started.{first}").exists(), "first function scan")
            overlap_deadline = time.monotonic() + 1.0
            while time.monotonic() < overlap_deadline and not (sync / "function.overlap").exists():
                time.sleep(0.01)
            release(sync, first)
            wait_for(lambda: (sync / f"started.{labels[1]}").exists(), "second function scan")
            release(sync, labels[1])
        elif SCENARIO in {
            "allocation-failure",
            "allocation-signal",
            "resolution-failure",
        }:
            pass
        else:
            wait_for(lambda: len(list(sync.glob("started.*"))) == len(labels), "all scanner markers")
            release_order = list(reversed(labels)) if SCENARIO == "failure-order" else labels
            for label in release_order:
                release(sync, label)
                wait_for(lambda label=label: (sync / f"finished.{label}").exists(), f"{label} completion")

        result_path = sync / "result"
        wait_for(result_path.exists, "sourced caller result")
        if process.poll() is not None or os.getsid(process.pid) != process.pid:
            raise AssertionError("test driver lost its isolated-session ownership before release")
        live_before_release = [pid for pid in started_pids(sync) if process_exists(pid)]
        if live_before_release:
            raise AssertionError(f"scanner processes survived before driver release: {live_before_release}")
        scratch_before_release = list(scratch.glob("sley-secrets.*"))
        if SCENARIO == "cleanup-failure":
            if len(scratch_before_release) != 1:
                raise AssertionError(
                    f"cleanup failure retained unexpected scratch: {scratch_before_release}"
                )
        elif scratch_before_release:
            raise AssertionError(f"scanner output scratch survived before driver release: {scratch_before_release}")
        with (sync / "driver-release").open("w", encoding="ascii") as gate:
            gate.write("release\n")

        try:
            stdout, stderr = process.communicate(timeout=8)
        except subprocess.TimeoutExpired as error:
            stdout = output_text(error.stdout)
            stderr = output_text(error.stderr)
            errors.append("sourced caller did not return after the operation")

        if not result_path.exists():
            errors.append("sourced caller did not publish its restored-state result")
            result: dict[str, str] = {}
        else:
            result = read_result(result_path)

        expected_rc = {
            "cancel-hup": "129",
            "cancel-int-ignore": "130",
            "cancel-term": "143",
            "cancel-term-pre-wait": "143",
            "cancel-term-cleanup": "143",
            "cancel-term-completed": "143",
            "cancel-term-extra-config": "143",
            "first-signal": "130",
            "allocation-failure": "2",
            "allocation-signal": "143",
            "cleanup-failure": "2",
            "failure-order": "2",
            "scanner-exit-129": "129",
            "scanner-exit-130": "130",
            "scanner-exit-143": "143",
            "resolution-failure": "2",
        }.get(SCENARIO, "0")
        if result.get("rc") != expected_rc:
            errors.append(f"operation rc was {result.get('rc')!r}, expected {expected_rc}")

        for key in ("traps_restored", "options_restored", "shopt_restored", "cwd_restored", "unrelated_alive"):
            if result.get(key) != "yes":
                errors.append(f"{key} was {result.get(key)!r}, expected 'yes'")

        if SCENARIO.startswith("cancel-") or SCENARIO == "first-signal":
            if result.get("caller_trap_count") != "0":
                errors.append("intercepted signal invoked a caller-owned trap")
            live = [pid for pid in started_pids(sync) if process_exists(pid)]
            if live:
                errors.append(f"scanner processes survived cancellation: {live}")
        if SCENARIO == "cancel-term-completed":
            completed_pid = int((sync / f"started.{labels[1]}").read_text(encoding="ascii"))
            kill_rows = (sync / "kill.log").read_text(encoding="ascii").splitlines()
            if any(row.split()[-1:] == [str(completed_pid)] for row in kill_rows):
                errors.append("cleanup signalled a scanner that had already completed")
        if SCENARIO in {"cancel-term-extra-config", "cancel-term-cleanup"} and (sync / "extra-config-started").exists():
            errors.append("cancellation started an extension secrets scan")
        if SCENARIO.startswith("scanner-exit-") and not (sync / "extra-config-started").exists():
            errors.append("scanner signal-shaped exit skipped the extension secrets scan")
        scratch_after = list(scratch.glob("sley-secrets.*"))
        if SCENARIO == "cleanup-failure":
            retained_path = sync / "retained-scratch"
            if not retained_path.exists():
                errors.append("cleanup failure did not identify retained scratch")
            else:
                retained = pathlib.Path(retained_path.read_text(encoding="utf-8").strip())
                if not (retained / "foreign").is_file():
                    errors.append("cleanup failure removed foreign content")
            if len(scratch_after) != 1:
                errors.append(f"cleanup failure retained unexpected scratch: {scratch_after!r}")
        elif scratch_after:
            errors.append("scanner output scratch survived the operation")
        if SCENARIO == "allocation-failure":
            if list(sync.glob("started.*")):
                errors.append("allocation failure launched a scanner")
        if SCENARIO == "allocation-signal":
            if list(sync.glob("started.*")):
                errors.append("interrupted allocation launched a scanner")
        if SCENARIO == "resolution-failure":
            if "unable to resolve gitleaks executable" not in stderr:
                errors.append("gitleaks resolution failure had no actionable diagnostic")
        if SCENARIO == "function-fallback" and (sync / "function.overlap").exists():
            errors.append("shell-function compatibility path ran scans in parallel")
        if SCENARIO == "success":
            if "stdout:" in stdout or "stderr:" in stderr:
                errors.append("successful scanner diagnostics were not quiet")
        if SCENARIO == "failure-order":
            stdout_rows = [line for line in stdout.splitlines() if line.startswith("stdout:")]
            stderr_rows = [line for line in stderr.splitlines() if line.startswith("stderr:")]
            if stdout_rows != ["stdout:1-a.txt", "stdout:2-b.txt"]:
                errors.append(f"stdout diagnostics were not file ordered: {stdout_rows}")
            if stderr_rows != ["stderr:1-a.txt", "stderr:2-b.txt"]:
                errors.append(f"stderr diagnostics were not file ordered: {stderr_rows}")
            if (sync / "cat-invoked").exists():
                errors.append("diagnostic replay invoked an external cat")
    except ExpectedEarlyExit:
        pass
    finally:
        owned_pids = started_pids(sync)
        unrelated_path = sync / "unrelated.pid"
        if unrelated_path.exists():
            owned_pids.append(int(unrelated_path.read_text(encoding="ascii")))
        group_is_owned = process.poll() is None and process_in_session(process.pid, process.pid)
        if not group_is_owned:
            for pid in owned_pids:
                try:
                    if process_in_session(pid, process.pid) and os.getpgid(pid) == process.pid:
                        group_is_owned = True
                        break
                except ProcessLookupError:
                    pass
        if group_is_owned:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        elif any(process_in_session(pid, process.pid) for pid in owned_pids):
            errors.append("test cleanup lost isolated-session ownership")
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            errors.append("test cleanup could not reap the sourced caller")
        deadline = time.monotonic() + 2
        while (
            any(process_in_session(pid, process.pid) for pid in owned_pids)
            and time.monotonic() < deadline
        ):
            time.sleep(0.01)
        survivors = [pid for pid in owned_pids if process_in_session(pid, process.pid)]
        if survivors:
            errors.append(f"test cleanup left owned processes: {survivors}")

    if errors:
        print(f"scenario: {SCENARIO}", file=sys.stderr)
        for error in errors:
            print(f"  {error}", file=sys.stderr)
        if stdout:
            print(f"  stdout: {stdout!r}", file=sys.stderr)
        if stderr:
            print(f"  stderr: {stderr!r}", file=sys.stderr)
        raise SystemExit(1)


