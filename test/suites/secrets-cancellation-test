  # test-side boundary injector so TERM still lands after the wait PID is
  # published but before Bash enters its real builtin wait.
  set -T
  wait_signal_fired=0
  trap 'if [[ "$wait_signal_fired" -eq 0 &&
    "$BASH_COMMAND" == '\''builtin wait "$pid"'\''* ]]; then
    wait_signal_fired=1
    trap - DEBUG
    : >"$SLEY_SECRETS_TEST_SYNC/signal-before-wait"
    builtin kill -TERM "$BASHPID"
