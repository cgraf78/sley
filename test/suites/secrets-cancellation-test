            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        elif any(process_in_session(pid, process.pid) for pid in owned_pids):
            errors.append("test cleanup lost isolated-session ownership")
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            errors.append("test cleanup could not reap the sourced caller")
        # The harness can kill every member of its isolated process group, but
        # it cannot reap a child that the intentionally exited driver already
        # orphaned to PID 1. Wait for executable processes to disappear and do
        # not turn a container init's retained zombie into a product failure.
        deadline = time.monotonic() + 2
        while (
            any(live_process_in_session(pid, process.pid) for pid in owned_pids)
            and time.monotonic() < deadline
        ):
            time.sleep(0.01)
        survivors = [pid for pid in owned_pids if live_process_in_session(pid, process.pid)]
        if survivors:
            errors.append(f"test cleanup left owned processes: {survivors}")
        if pty_slave is not None:
            os.close(pty_slave)
        if pty_master is not None:
            os.close(pty_master)

    if errors:
        print(f"scenario: {SCENARIO}", file=sys.stderr)
        for error in errors:
            print(f"  {error}", file=sys.stderr)
        if stdout:
            print(f"  stdout: {stdout!r}", file=sys.stderr)
        if stderr:
            print(f"  stderr: {stderr!r}", file=sys.stderr)
        raise SystemExit(1)


