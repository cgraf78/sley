def release(sync: pathlib.Path, label: str) -> None:
    gate = sync / f"release.{label}"
    # A normal FIFO writer open blocks forever if the fixture never reached its
    # reader. Probe nonblocking so a broken product path becomes a bounded,
    # named synchronization failure instead of wedging the test and its cleanup.
    deadline = time.monotonic() + 8.0
    while True:
        try:
            fd = os.open(gate, os.O_WRONLY | os.O_NONBLOCK)
            break
        except OSError as error:
            if error.errno != errno.ENXIO or time.monotonic() >= deadline:
                raise
            time.sleep(0.01)
    try:
        os.write(fd, b"x")
    finally:
        os.close(fd)


def started_pids(sync: pathlib.Path) -> list[int]:
    pids: list[int] = []
    for path in sync.glob("started.*"):
        contents = path.read_text(encoding="ascii").strip()
        if contents:
            pids.append(int(contents))
    return pids


def run_case() -> None:
    case_dir = pathlib.Path(tempfile.mkdtemp(prefix=f"{SCENARIO}.", dir=BASE))
    sync = case_dir / "sync"
    scratch = case_dir / "scratch"
    bin_dir = case_dir / "bin"
    home = case_dir / "home"
    extensions = case_dir / "extensions"
    sync.mkdir()
    scratch.mkdir()
    bin_dir.mkdir()
    home.mkdir()
    extensions.mkdir()
    os.mkfifo(sync / "driver-release", 0o600)
    global_git_config = home / ".gitconfig"
    global_git_config.touch()

    labels = ["0-a.txt", "0-b.txt", "0-c.txt", "0-d.txt"]
    if SCENARIO == "cancel-term-message":
        labels = ["message-base", "message-extra"]
    elif SCENARIO == "failure-order":
        labels = ["1-a.txt", "2-b.txt"]
    elif SCENARIO in {
        "allocation-failure",
        "allocation-count",
        "allocation-child-signal",
        "allocation-interrupted-130",
        "allocation-stale-job-status",
        "allocation-signal",
        "cancel-int-monitor-allocation",
        "cleanup-failure",
        "cleanup-command-shadow",
        "cancel-term-cleanup-persistent",
        "cancel-term-cleanup-late-persistent",
        "cancel-term-builtin-shadow",
        "cancel-term-function",
        "cancel-term-serial",
        "function-fallback",
        "cancel-term-completed",
    }:
        labels = ["0-a.txt", "0-b.txt"]
    elif SCENARIO in {"failure-output-function", "failure-output-serial"}:
        labels = ["1-a.txt"]
    elif SCENARIO.startswith("scanner-exit-"):
        labels = [f"{SCENARIO.rsplit('-', 1)[1]}-a.txt"]

    repo = make_repo(case_dir, labels)
    if SCENARIO == "cancel-term-message":
        (repo / "message").write_text("ordinary message\n", encoding="utf-8")
    for label in labels:
        os.mkfifo(sync / f"release.{label}", 0o600)

    gitleaks = bin_dir / "gitleaks"
    write_executable(gitleaks, f"#!{PYTHON}\n{MOCK_GITLEAKS}")
    if SCENARIO in {
        "allocation-child-signal",
        "allocation-interrupted-130",
        "allocation-stale-job-status",
        "cancel-int-monitor-allocation",
    }:
        real_mkdir = shutil.which("mkdir")
        if real_mkdir is None:
            raise AssertionError("mkdir unavailable for allocation signal fixture")
        os.mkfifo(sync / "allocation-child-release", 0o600)
        write_executable(
            bin_dir / "mkdir",
            "#!/usr/bin/env bash\n"
            "set -u\n"
            "target=\n"
            "for arg in \"$@\"; do target=$arg; done\n"
            "case \"$target\" in\n"
            "  *sley-secrets.*)\n"
            "    printf '%s\\n' \"$$\" >\"$SLEY_SECRETS_TEST_SYNC/allocation-child.pid\"\n"
            "    IFS= read -r _ <\"$SLEY_SECRETS_TEST_SYNC/allocation-child-release\"\n"
            "    ;;\n"
            "esac\n"
            # A real child status can have the same numeric value as Bash's
            # synthetic status for an interrupted wait. The parent must get
            # the child's authored result from a separate completion channel,
            # rather than re-waiting forever based on the number alone.
            "if [[ ${SLEY_SECRETS_TEST_ALLOCATION_STATUS:-0} -ne 0 ]]; then\n"
