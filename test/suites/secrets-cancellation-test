if [[ "${SLEY_SECRETS_TEST_SHADOW_OWNERSHIP_BUILTINS:-0}" == 1 ]]; then
  # A sourced library shares command lookup with its caller. These wrappers
  # still delegate so the scenario remains bounded, but record any ownership-
  # critical operation that did not select a Bash builtin or real utility
  # explicitly.
  command() {
    case " ${FUNCNAME[*]} " in
      *" _sley_secrets_parallel_"*)
        case "${1:-}" in
          rm | rmdir) : >"$SLEY_SECRETS_TEST_SYNC/shadow-command-invoked" ;;
        esac
