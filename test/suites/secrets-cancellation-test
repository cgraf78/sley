  # command lookup. These sentinels deliberately claim success without removing
  # anything: cleanup must bypass them or it could report success while secret
  # scanner output remains on disk.
  rm() {
    : >"$SLEY_SECRETS_TEST_SYNC/shadow-rm-invoked"
    return 0
