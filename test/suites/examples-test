#!/usr/bin/env bash
# examples-test — keep copyable examples aligned with Sley's public contracts.

set -uo pipefail
export NO_COLOR=1

SLEY_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
SLEY_REPO_ROOT="$(cd -- "$SLEY_TEST_DIR/.." && pwd -P)"
SLEY="$SLEY_REPO_ROOT/bin/sley"
EXAMPLES="$SLEY_REPO_ROOT/examples"

# shellcheck source=../helpers.sh
. "$SLEY_TEST_DIR/helpers.sh"

echo "=== sley copyable examples ==="

message=$(_tmpdir)/message
cat >"$message" <<'EOF'
Document consumer-owned Sley examples

## Summary

Add copyable examples without duplicating provider-owned hooks.

## Testing

Run the focused example suite.
EOF

template_out=$("$SLEY" hook validate-message \
  --template "$EXAMPLES/commit-message-template.txt" \
  --message-file "$message" 2>&1)
template_rc=$?
_assert_exit "commit template: accepts a populated example message" 0 "$template_rc"
_assert_eq "commit template: valid message is quiet" "" "$template_out"

repo=$(_tmpdir)
home=$(_tmpdir)
mkdir -p "$repo/src" "$repo/config" "$home/config"
git -C "$repo" init -q
git -C "$repo" config user.email test@example.invalid
git -C "$repo" config user.name "Sley Test"
git -C "$repo" config commit.gpgsign false
# The fixture is testing Sley's example inputs, not the host's active Git
# policy. Override any global core.hooksPath before creating the seed commit so
# the suite remains hermetic on a machine that already uses Sley's live hooks.
git -C "$repo" config core.hooksPath "$repo/.git/hooks"
printf 'initial\n' >"$repo/src/app.txt"
printf 'initial\n' >"$repo/config/example.schema"
git -C "$repo" add src/app.txt config/example.schema
git -C "$repo" commit -q -m seed
printf 'changed\n' >>"$repo/src/app.txt"

verify_out=$(
  cd "$repo" || exit 1
  HOME="$home" XDG_CONFIG_HOME="$home/config" \
    SLEY_EXTENSION_DIR="$home/extensions" \
    SLEY_VERIFY_CONFIG="$EXAMPLES/verify.json" \
    "$SLEY" verify --json 2>&1
)
verify_rc=$?
_assert_exit "verify registry: copyable config is accepted" 0 "$verify_rc"
_assert_contains "verify registry: example command is discovered" \
  '"command":"./test/run"' "$verify_out"
_assert_contains "verify registry: placeholder remains suggested" \
  '"required":false' "$verify_out"

git -C "$repo" restore src/app.txt
printf 'changed\n' >>"$repo/config/example.schema"
extension_out=$(
  cd "$repo" || exit 1
  HOME="$home" XDG_CONFIG_HOME="$home/config" \
    SLEY_EXTENSION_DIR="$EXAMPLES/extensions.d" \
    SLEY_VERIFY_CONFIG="$home/missing-verify.json" \
    "$SLEY" verify --json 2>&1
)
extension_rc=$?
_assert_exit "extension: copyable dynamic provider is accepted" 0 "$extension_rc"
_assert_contains "extension: matching file discovers the example command" \
  '"command":"./test/validate-schemas"' "$extension_out"
_assert_contains "extension: placeholder remains suggested" \
  '"required":false' "$extension_out"

git -C "$repo" restore config/example.schema
lint_mock_bin=$(_tmpdir)
mkdir -p \
  "$repo/vendor/generated" \
  "$repo/web/legacy" \
  "$home/config/sley/lint-ignore.d"
printf 'initial\n' >"$repo/vendor/generated/cache.txt"
printf 'initial\n' >"$repo/web/legacy/ui.js"
git -C "$repo" add vendor/generated/cache.txt web/legacy/ui.js
git -C "$repo" commit -q -m "seed generated example"
printf 'changed\n' >>"$repo/src/app.txt"
printf 'changed\n' >>"$repo/vendor/generated/cache.txt"
printf 'changed\n' >>"$repo/web/legacy/ui.js"
cp "$EXAMPLES/lint-ignore.d/10-generated.paths" \
  "$home/config/sley/lint-ignore.d/10-generated.paths"
example_lint_log=$repo/example-lint.log
cat >"$lint_mock_bin/autolint" <<'EOF'
#!/usr/bin/env bash
printf '<%s>' "$@" >"$SLEY_EXAMPLE_LINT_LOG"
EOF
chmod +x "$lint_mock_bin/autolint"
lint_ignore_out=$(
  cd "$repo" || exit 1
  HOME="$home" XDG_CONFIG_HOME="$home/config" \
    SLEY_EXTENSION_DIR="$home/extensions" \
    SLEY_EXAMPLE_LINT_LOG="$example_lint_log" \
    PATH="$lint_mock_bin:$PATH" "$SLEY" check --repo-wide 2>&1
)
lint_ignore_rc=$?
_assert_exit "lint ignore: copyable config is accepted" 0 "$lint_ignore_rc"
_assert_contains "lint ignore: ordinary changed path reaches the provider" \
  '<src/app.txt>' "$(cat "$example_lint_log" 2>/dev/null)"
_assert_not_contains "lint ignore: configured subtree does not reach the provider" \
  'vendor/generated/cache.txt' "$(cat "$example_lint_log" 2>/dev/null)"
_assert_not_contains "lint ignore: every shipped prefix stays executable" \
  'web/legacy/ui.js' "$(cat "$example_lint_log" 2>/dev/null)"
_assert_contains "lint ignore: runtime reports both example exclusions" \
  'ignored lint for 2 configured files' "$lint_ignore_out"
_assert_not_contains "lint ignore: copyable config emits no parser warning" \
  'lint-ignore' "$lint_ignore_out"

mock_bin=$(_tmpdir)
cat >"$mock_bin/sley" <<'EOF'
#!/usr/bin/env bash
printf 'skip-untracked=%s\n' "${SLEY_SKIP_UNTRACKED:-}"
printf 'args=%s\n' "$*"
EOF
chmod +x "$mock_bin/sley"
gate_out=$(PATH="$mock_bin:$PATH" "$EXAMPLES/hooks/custom-sley-commit-gate" 2>&1)
gate_rc=$?
_assert_exit "Git gate wrapper: delegates successfully" 0 "$gate_rc"
_assert_contains "Git gate wrapper: applies only its documented policy" \
  'skip-untracked=1' "$gate_out"
_assert_contains "Git gate wrapper: returns to the public readiness command" \
  'args=ready --fix --commit' "$gate_out"

_test_summary
