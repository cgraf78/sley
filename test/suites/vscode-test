#!/usr/bin/env bash
# vscode-test — packaging and behavior tests for Sley's VS Code extension.

set -euo pipefail

SLEY_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
SLEY_REPO_ROOT="$(cd -- "$SLEY_TEST_DIR/.." && pwd -P)"
extension_path="$SLEY_REPO_ROOT/share/sley/vscode/sley-tools-0.0.1"

# shellcheck source=../helpers.sh
. "$SLEY_TEST_DIR/helpers.sh"

echo "=== sley: VS Code extension ==="

# The versioned directory is part of the consumer contract: VS Code derives the
# installed directory name from package metadata, while shdeps consumers need a
# stable repository-relative path they can resolve without running npm.
_assert_file_exists "vscode extension: manifest is published" "$extension_path/package.json"
_assert_file_exists "vscode extension: entry point is published" "$extension_path/extension.js"

if ! command -v node >/dev/null 2>&1; then
  echo "  SKIP: vscode behavior checks require Node.js"
  _test_summary
fi

SLEY_TEST_VSCODE_EXTENSION_PATH="$extension_path" node <<'NODE'
const assert = require("node:assert/strict");
const fs = require("node:fs");
const Module = require("node:module");
const os = require("node:os");
const path = require("node:path");

const extensionPath = process.env.SLEY_TEST_VSCODE_EXTENSION_PATH;
assert.ok(extensionPath, "SLEY_TEST_VSCODE_EXTENSION_PATH is required");
const extensionFile = path.join(extensionPath, "extension.js");
const manifest = JSON.parse(
  fs.readFileSync(path.join(extensionPath, "package.json"), "utf8"),
);
assert.equal(manifest.name, "sley-tools");
assert.equal(manifest.publisher, "cgraf");
assert.equal(path.basename(extensionPath), `${manifest.name}-${manifest.version}`);
assert.equal(path.resolve(extensionPath, manifest.main), extensionFile);
const calls = [];
const diagnosticSets = [];
const diagnosticDeletes = [];
const config = {
  checkrunCommand: "checkrun",
  command: "sley",
  diagnosticExclude: [],
  lintOnOpen: false,
  lintOnSave: true,
  timeoutMs: 10000,
};
let registeredProvider;
let registeredSelector;
let refreshDiagnostics;
let activeEditorChangeHandler;
let changeDocumentHandler;
let openDocumentHandler;
let saveDocumentHandler;
let deferredCapabilities = false;
let deferredLint = false;
let activeLintCalls = 0;
let completedLintCalls = 0;
let abortedLintCalls = 0;
let maxActiveLintCalls = 0;
const pendingCapabilityCallbacks = [];
const pendingLintCallbacks = [];
let failFirstCapabilities = false;
let failAllCapabilities = false;
let workspaceRoot;

class Position {
  constructor(line, character) {
    this.line = line;
    this.character = character;
  }

  translate(lineDelta, characterDelta) {
    return new Position(this.line + lineDelta, this.character + characterDelta);
  }
}

class Range {
  constructor(start, end) {
    this.start = start;
    this.end = end;
  }
}

class Diagnostic {
  constructor(range, message, severity) {
    this.range = range;
    this.message = message;
    this.severity = severity;
  }
}

const vscode = {
  Diagnostic,
  DiagnosticSeverity: {
    Error: 0,
    Warning: 1,
    Information: 2,
    Hint: 3,
  },
  Position,
  Range,
  TextEdit: {
    replace(range, newText) {
      return { range, newText };
    },
  },
  commands: {
    registerCommand(name, handler) {
      if (name === "sleyTools.refreshDiagnostics") refreshDiagnostics = handler;
      return { dispose() {} };
    },
  },
  languages: {
    createDiagnosticCollection() {
      return {
        delete(uri) {
          diagnosticDeletes.push(uri);
        },
        dispose() {},
        set(uri, diagnostics) {
          diagnosticSets.push({ uri, diagnostics });
        },
      };
    },
    registerDocumentFormattingEditProvider(selector, provider) {
      registeredSelector = selector;
      registeredProvider = provider;
      return { dispose() {} };
    },
  },
  window: {
    onDidChangeActiveTextEditor(handler) {
      activeEditorChangeHandler = handler;
      return { dispose() {} };
    },
  },
  workspace: {
    textDocuments: [],
    getConfiguration() {
      return {
        get(key) {
          return config[key];
        },
      };
    },
    getWorkspaceFolder(uri) {
      if (
        workspaceRoot &&
        uri?.fsPath?.startsWith(`${workspaceRoot}${path.sep}`)
      ) {
        return { uri: { fsPath: workspaceRoot } };
      }
      return undefined;
    },
    onDidChangeTextDocument(handler) {
      changeDocumentHandler = handler;
      return { dispose() {} };
    },
    onDidOpenTextDocument(handler) {
      openDocumentHandler = handler;
      return { dispose() {} };
    },
    onDidSaveTextDocument(handler) {
      saveDocumentHandler = handler;
      return { dispose() {} };
    },
  },
};

const filetypes = {
  custom: {
    extension: {
      bzl: "bzl",
      service: "systemd",
    },
    filename: {
      ".editorconfig": "editorconfig",
      ".gitconfig": "gitconfig",
      BUILD: "bzl",
      "tmux.conf": "tmux",
    },
    patterns: [
      {
        filetype: "bzl",
        pattern: "WORKSPACE.*",
      },
    ],
  },
  format: ["bzl", "cpp", "python", "systemd"],
  lint: ["bzl", "editorconfig", "gitconfig", "systemd", "tmux"],
};
const editorLanguageIds = {
  vscode: {
    bzl: ["starlark", "bzl"],
    systemd: ["systemd"],
  },
};

function execFile(command, args, opts, callback) {
  calls.push({ command, args, opts });
  if (command === "checkrun") {
    if (failFirstCapabilities) {
      failFirstCapabilities = false;
      callback(Object.assign(new Error("checkrun unavailable"), { code: "ENOENT" }), "", "");
      return;
    }
    if (failAllCapabilities) {
      callback(Object.assign(new Error("checkrun unavailable"), { code: "ENOENT" }), "", "");
      return;
    }
    if (deferredCapabilities) {
      pendingCapabilityCallbacks.push(callback);
      return;
    }
    callback(null, JSON.stringify({ editorLanguageIds, filetypes, version: 2 }), "");
    return;
  }
  if (command === "sley" && args[0] === "hook" && args[1] === "format-file") {
    fs.writeFileSync(args[2], "formatted\n");
    callback(null, "", "");
    return;
  }
  if (command === "sley" && args[0] === "hook" && args[1] === "lint-file") {
    if (deferredLint) {
      activeLintCalls += 1;
      maxActiveLintCalls = Math.max(maxActiveLintCalls, activeLintCalls);
      let settled = false;
      const finish = (err) => {
        if (settled) return;
        settled = true;
        activeLintCalls -= 1;
        if (err) abortedLintCalls += 1;
        else completedLintCalls += 1;
        callback(err, "", "");
      };
      pendingLintCallbacks.push(() => finish(null));
      opts.signal?.addEventListener(
        "abort",
        () => finish(Object.assign(new Error("aborted"), { name: "AbortError" })),
        { once: true },
      );
      return;
    }
    const output = [
      JSON.stringify({
        line: 2,
        col: 3,
        end_line: 2,
        end_col: 8,
        severity: "error",
        code: "E001",
        message: "bad setting",
        source: "autolint",
      }),
      "not json",
    ].join("\n");
    callback(Object.assign(new Error("lint failed"), { code: 1 }), output, "");
    return;
  }
  callback(new Error(`unexpected command: ${command} ${args.join(" ")}`), "", "");
}

const originalLoad = Module._load;
Module._load = function load(request, parent, isMain) {
  if (request === "vscode") return vscode;
  if (request === "node:child_process") return { execFile };
  return originalLoad.call(this, request, parent, isMain);
};

function document(filePath, languageId, text) {
  const lines = text.split("\n");
  return {
    isUntitled: false,
    languageId,
    lineCount: lines.length,
    version: 1,
    uri: {
      fsPath: filePath,
      scheme: "file",
    },
    getText() {
      return text;
    },
    lineAt(line) {
      return {
        range: {
          end: new Position(line, lines[line]?.length || 0),
        },
      };
    },
    positionAt(offset) {
      const before = text.slice(0, offset).split("\n");
      return new Position(before.length - 1, before[before.length - 1].length);
    },
  };
}

async function nextTurn() {
  await new Promise((resolve) => setImmediate(resolve));
}

async function drainDeferredLints() {
  while (activeLintCalls > 0 || pendingLintCallbacks.length > 0) {
    const callbacks = pendingLintCallbacks.splice(0);
    for (const callback of callbacks) callback();
    await nextTurn();
  }
}

(async () => {
  const extension = require(extensionFile);
  const context = {
    extensionPath,
    subscriptions: [],
  };

  const byLanguage = extension._test.languageToFiletypes(editorLanguageIds.vscode);
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "vscode-sley-test-"));
  workspaceRoot = tmp;
  try {
    assert.equal(
      extension._test.supports(document(path.join(tmp, ".editorconfig"), "plaintext", ""), filetypes, byLanguage, "lint"),
      true,
    );
    assert.equal(
      extension._test.supports(document(path.join(tmp, ".gitconfig"), "plaintext", ""), filetypes, byLanguage, "lint"),
      true,
    );
    assert.equal(
      extension._test.supports(document(path.join(tmp, "tmux.conf"), "plaintext", ""), filetypes, byLanguage, "lint"),
      true,
    );
    assert.equal(
      extension._test.supports(document(path.join(tmp, "BUILD"), "plaintext", ""), filetypes, byLanguage, "lint"),
      true,
    );
    assert.equal(
      extension._test.supports(document(path.join(tmp, "demo.service"), "plaintext", ""), filetypes, byLanguage, "lint"),
      true,
    );
    assert.equal(
      extension._test.supports(document(path.join(tmp, "WORKSPACE.local"), "plaintext", ""), filetypes, byLanguage, "lint"),
      true,
    );

    await extension.activate(context);
    assert.deepEqual(registeredSelector, [
      { scheme: "file", language: "bzl" },
      { scheme: "file", language: "cpp" },
      { scheme: "file", language: "python" },
      { scheme: "file", language: "starlark" },
      { scheme: "file", language: "systemd" },
    ]);
    assert.ok(registeredProvider, "format provider registered");
    assert.equal(typeof refreshDiagnostics, "function");

    const servicePath = path.join(tmp, "demo.service");
    fs.writeFileSync(servicePath, "original disk\n");
    const edits = await registeredProvider.provideDocumentFormattingEdits(
      document(servicePath, "plaintext", "dirty buffer\n"),
    );
    assert.equal(fs.readFileSync(servicePath, "utf8"), "original disk\n");
    assert.equal(edits.length, 1);
    assert.equal(edits[0].newText, "formatted\n");
    const formatCall = calls.find(
      (call) => call.command === "sley" && call.args.slice(0, 2).join(" ") === "hook format-file",
    );
    assert.ok(formatCall, "format command called");
    assert.equal(path.basename(formatCall.args[2]), "demo.service");
    assert.match(path.dirname(formatCall.args[2]), /\.sley-vscode-/);
    assert.equal(formatCall.opts.cwd, tmp);

    const tmuxDoc = document(path.join(tmp, "tmux.conf"), "plaintext", "set -g status on\n");
    vscode.workspace.textDocuments = [tmuxDoc];
    await refreshDiagnostics();
    const lintCall = calls.find(
      (call) => call.command === "sley" && call.args.slice(0, 3).join(" ") === "hook lint-file --json",
    );
    assert.ok(lintCall, "lint command called");
    assert.equal(lintCall.args[3], tmuxDoc.uri.fsPath);
    assert.equal(lintCall.opts.cwd, tmp);
    assert.equal(diagnosticSets.length, 1);
    assert.equal(diagnosticSets[0].diagnostics.length, 1);
    assert.equal(diagnosticSets[0].diagnostics[0].message, "bad setting");
    assert.equal(diagnosticSets[0].diagnostics[0].severity, vscode.DiagnosticSeverity.Error);
    assert.equal(diagnosticSets[0].diagnostics[0].code, "E001");
    assert.equal(diagnosticSets[0].diagnostics[0].source, "autolint");

    config.diagnosticExclude = ["third_party/**"];
    const excludedDoc = document(
      path.join(tmp, "third_party", "tmux.conf"),
      "plaintext",
      "set -g status on\n",
    );
    calls.length = 0;
    diagnosticDeletes.length = 0;
    vscode.workspace.textDocuments = [excludedDoc];
    await refreshDiagnostics();
    assert.equal(
      calls.some(
        (call) =>
          call.command === "sley" &&
          call.args.slice(0, 3).join(" ") === "hook lint-file --json",
      ),
      false,
    );
    assert.equal(diagnosticDeletes[0], excludedDoc.uri);
    config.diagnosticExclude = [];

    delete require.cache[require.resolve(extensionFile)];
    registeredProvider = undefined;
    failFirstCapabilities = true;
    calls.length = 0;
    const originalConsoleError = console.error;
    try {
      console.error = () => {};
      await require(extensionFile).activate({
        extensionPath,
        subscriptions: [],
      });
    } finally {
      console.error = originalConsoleError;
    }
    const cppPath = path.join(tmp, "raw_test.cpp");
    const cppEdits = await registeredProvider.provideDocumentFormattingEdits(
      document(cppPath, "cpp", "int   main() {}\n"),
    );
    assert.equal(cppEdits.length, 1);
    assert.equal(cppEdits[0].newText, "formatted\n");
    assert.equal(calls.filter((call) => call.command === "checkrun").length, 2);

    delete require.cache[require.resolve(extensionFile)];
    activeEditorChangeHandler = undefined;
    activeLintCalls = 0;
    completedLintCalls = 0;
    abortedLintCalls = 0;
    maxActiveLintCalls = 0;
    pendingLintCallbacks.length = 0;
    calls.length = 0;
    config.lintOnOpen = true;
    deferredLint = true;
    vscode.workspace.textDocuments = Array.from({ length: 10 }, (_, index) =>
      document(path.join(tmp, `startup-${index}.service`), "systemd", "[Unit]\n"),
    );
    let startupActivationSettled = false;
    const startupActivation = require(extensionFile).activate({
      extensionPath,
      subscriptions: [],
    });
    startupActivation.then(() => {
      startupActivationSettled = true;
    });
    await nextTurn();
    assert.equal(startupActivationSettled, true, "startup lint does not delay activation");
    assert.equal(maxActiveLintCalls, 4, "startup lint concurrency is bounded");
    assert.equal(typeof activeEditorChangeHandler, "function", "editor focus lint remains enabled");
    activeEditorChangeHandler({ document: vscode.workspace.textDocuments[0] });
    openDocumentHandler(vscode.workspace.textDocuments[0]);
    saveDocumentHandler(vscode.workspace.textDocuments[0]);
    const overlappingRefresh = refreshDiagnostics();
    await drainDeferredLints();
    await overlappingRefresh;
    assert.equal(completedLintCalls, 10, "overlapping lint triggers share in-flight work");
    assert.equal(maxActiveLintCalls, 4, "all lint triggers share one concurrency budget");
    await startupActivation;
    deferredLint = false;

    delete require.cache[require.resolve(extensionFile)];
    diagnosticSets.length = 0;
    activeLintCalls = 0;
    pendingLintCallbacks.length = 0;
    config.lintOnOpen = false;
    deferredLint = true;
    vscode.workspace.textDocuments = [];
    await require(extensionFile).activate({ extensionPath, subscriptions: [] });
    const staleDocument = document(path.join(tmp, "stale.service"), "systemd", "[Unit]\n");
    saveDocumentHandler(staleDocument);
    await nextTurn();
    staleDocument.version += 1;
    await drainDeferredLints();
    assert.equal(diagnosticSets.length, 0, "outdated lint results are not published");
    deferredLint = false;
    config.lintOnOpen = true;

    delete require.cache[require.resolve(extensionFile)];
    activeLintCalls = 0;
    completedLintCalls = 0;
    abortedLintCalls = 0;
    maxActiveLintCalls = 0;
    pendingLintCallbacks.length = 0;
    deferredLint = true;
    vscode.workspace.textDocuments = Array.from({ length: 6 }, (_, index) =>
      document(path.join(tmp, `dispose-${index}.service`), "systemd", "[Unit]\n"),
    );
    const disposableContext = { extensionPath, subscriptions: [] };
    await require(extensionFile).activate(disposableContext);
    await nextTurn();
    assert.equal(activeLintCalls, 4, "startup fills only the shared lint budget");
    for (const subscription of disposableContext.subscriptions) subscription.dispose();
    await nextTurn();
    assert.equal(activeLintCalls, 0, "extension disposal cancels active lint work");
    assert.equal(abortedLintCalls, 4, "every active lint is aborted on disposal");
    assert.equal(completedLintCalls, 0, "disposed startup work does not complete later");
    pendingLintCallbacks.length = 0;
    deferredLint = false;

    delete require.cache[require.resolve(extensionFile)];
    calls.length = 0;
    pendingCapabilityCallbacks.length = 0;
    failFirstCapabilities = true;
    deferredCapabilities = true;
    vscode.workspace.textDocuments = Array.from({ length: 10 }, (_, index) =>
      document(path.join(tmp, `retry-${index}.service`), "systemd", "[Unit]\n"),
    );
    const retryActivation = require(extensionFile).activate({
      extensionPath,
      subscriptions: [],
    });
    await nextTurn();
    assert.equal(
      calls.filter((call) => call.command === "checkrun").length,
      2,
      "startup documents share one capability retry",
    );
    assert.equal(pendingCapabilityCallbacks.length, 1);
    deferredCapabilities = false;
    for (const callback of pendingCapabilityCallbacks.splice(0)) {
      callback(null, JSON.stringify({ editorLanguageIds, filetypes, version: 2 }), "");
    }
    await retryActivation;
    await nextTurn();

    delete require.cache[require.resolve(extensionFile)];
    calls.length = 0;
    failAllCapabilities = true;
    vscode.workspace.textDocuments = Array.from({ length: 10 }, (_, index) =>
      document(path.join(tmp, `failed-${index}.service`), "systemd", "[Unit]\n"),
    );
    const originalPersistentConsoleError = console.error;
    try {
      console.error = () => {};
      await require(extensionFile).activate({
        extensionPath,
        subscriptions: [],
      });
      await nextTurn();
      await nextTurn();
    } finally {
      console.error = originalPersistentConsoleError;
      failAllCapabilities = false;
    }
    assert.equal(
      calls.filter((call) => call.command === "checkrun").length,
      2,
      "persistent capability failure is attempted once per startup batch",
    );
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
    Module._load = originalLoad;
  }
})().catch((err) => {
  console.error(err);
  process.exit(1);
});
NODE

# Reaching here proves the complete behavior suite ran rather than being
# silently skipped after only checking the published package shape.
_pass "vscode extension: behavior checks pass"
_test_summary
