#!/usr/bin/env bash
# Run all repo-owned sley test suites.

set -euo pipefail

test_dir="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
root="${test_dir%/test}"

# shellcheck source=test/git-fixture-env.sh
. "$test_dir/git-fixture-env.sh"

# Suites started by this runner must begin with their own fixture environment.
unset BASH_ENV ENV

# Keep runtime entry points explicit so additions require a lint review.
runtime_shell_files=(
  "$root/bin/sley"
  "$root/lib/sley/hooks.sh"
  "$root/lib/sley/ready.sh"
  "$root/lib/sley/repo.sh"
  "$root/lib/sley/scope.sh"
  "$root/lib/sley/sley.sh"
  "$root/lib/sley/verify.sh"
  "$root/share/sley/hooks/git/pre-applypatch"
  "$root/share/sley/hooks/git/pre-commit"
  "$root/share/sley/hooks/git/pre-merge-commit"
  "$root/share/sley/hooks/git/commit-msg"
  "$root/share/sley/hooks/git/prepare-commit-msg"
  "$root/share/sley/hooks/git/sley-commit-gate"
  "$root/share/sley/hooks/sapling/sley-commit-gate"
  "$root/share/sley/shell.sh"
)

check_runtime_shell_inventory() {
  local file first_line listed discovered inventory
  listed=$(
    for file in "$@"; do
      printf '%q\n' "${file#"$root"/}"
    done | LC_ALL=C sort
  )
  discovered=$(
    # Git can print useful paths before rejecting an incomplete index read.
    # Stage its literal filenames and start the classification after success.
    if [[ -n ${TMPDIR:-} ]]; then
      inventory=$(mktemp -- "${TMPDIR%/}/runtime-inventory.XXXXXX") || return
    else
      inventory=$(mktemp) || return
    fi
    trap 'rm -f -- "$inventory"' EXIT
    GIT_TEST_ASSUME_DIFFERENT_OWNER=1 \
      _test_checkout_files "$root" bin lib share >"$inventory" || return
    while IFS= read -r -d '' file; do
      case "$file" in
        *.sh | *.sh.template)
          printf '%q\n' "$file"
          continue
          ;;
      esac
      first_line=""
      IFS= read -r first_line <"$root/$file" || true
      if [[ "$first_line" == '#!'*bash* ||
        "$first_line" == '#!'*dash* ||
        "$first_line" == '#!'*ksh* ||
        "$first_line" == '#!'*/sh ||
        "$first_line" == '#!'*'/sh '* ||
        "$first_line" == '#!'*' sh' ||
        "$first_line" == '#!'*' sh '* ||
        "$first_line" == '# shellcheck shell=bash' ||
        "$first_line" == '# shellcheck shell=dash' ||
        "$first_line" == '# shellcheck shell=ksh' ||
        "$first_line" == '# shellcheck shell=sh' ]]; then
        printf '%q\n' "$file"
      fi
    done <"$inventory"
  ) || {
    printf '%s\n' 'sley-test: cannot enumerate runtime shell files' >&2
    return 1
  }
  discovered=$(printf '%s\n' "$discovered" | sed '/^$/d' | LC_ALL=C sort)

  if [[ "$listed" != "$discovered" ]]; then
    printf 'sley-test: runtime shell inventory is stale\n' >&2
    diff -u \
      <(printf '%s\n' "$listed") \
      <(printf '%s\n' "$discovered") >&2 || true
    return 1
  fi
}

inventory_status=0
inventory_error=$(
  # shellcheck disable=SC2329 # Called by _test_checkout_files.
  git() {
    command git "$@" || return
    return 17
  }
  check_runtime_shell_inventory "${runtime_shell_files[@]}" 2>&1
) || inventory_status=$?
if [[ "$inventory_status" != 1 ||
  "$inventory_error" != 'sley-test: cannot enumerate runtime shell files' ]]; then
  printf '%s\n' 'sley-test: runtime shell inventory did not reject a Git error' >&2
  exit 1
fi

# One unusual pathname must not stand in for two intended entries.
inventory_status=0
inventory_error=$(
  # shellcheck disable=SC2329 # Called by _test_checkout_files.
  git() {
    printf '%s\0' $'lib/first.sh\nlib/second.sh'
  }
  check_runtime_shell_inventory "$root/lib/first.sh" "$root/lib/second.sh" 2>&1
) || inventory_status=$?
if [[ "$inventory_status" != 1 || "$inventory_error" != *'runtime shell inventory is stale'* ]]; then
  printf '%s\n' 'sley-test: runtime shell inventory did not preserve pathname boundaries' >&2
  exit 1
fi
check_runtime_shell_inventory "${runtime_shell_files[@]}"
# Shared CI lints once in its dedicated job; local runs still lint by default.
if [[ "${SLEY_SKIP_SHELLCHECK:-0}" != 1 ]]; then
  shellcheck -x -P SCRIPTDIR \
    "${runtime_shell_files[@]}" \
    "$root/install.sh" \
    "$root/scripts/checkout-installer.conf" \
    "$root/support/install-checkout.sh" \
    "$test_dir/sley-test" \
    "$test_dir/helpers.sh" \
    "$test_dir"/suites/*-test
fi

for suite in "$test_dir"/suites/*-test; do
  "$suite"
done

printf 'sley-test: ok\n'
